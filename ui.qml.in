import QtQuick 2.15
import QtQuick.Controls 2.15
import QtQuick.Layouts 1.15
import QtQuick.Controls.Material 2.2
import QtQuick.Window 2.2

import Vedder.vesc.vescinterface 1.0
import Vedder.vesc.commands 1.0
import Vedder.vesc.configparams 1.0
import Vedder.vesc.utility 1.0

Item {
    id: mainItem
    // Refloat's mainItem does this too (confirmed by reading its actual
    // source, vedderb/vesc_pkg/refloat/ui.qml.in) - it's the standard,
    // correct way to have this root Item track its host container's
    // real, live size. An earlier version of this file was missing it
    // entirely and instead reached for mainItem.parent from deep inside
    // child components as a workaround, which is what actually needed
    // all the platform-specific size branching below - most of that
    // complexity should no longer be necessary with this in place.
    anchors.fill: parent
    // Bumped on every edit - shown in the header as "build N" so a
    // stale/cached install is obvious at a glance instead of ambiguous.
    property int buildMarker: 14
    // Desktop and phone hosts need genuinely different sizing rules, not
    // one compromise value - a cap small enough to avoid overflowing a
    // phone screen leaves desktop far too small, and anything generous
    // enough for desktop overflows on a phone. Qt.platform.os is a
    // standard Qt/QML global, independent of anything VESC Tool-specific.
    readonly property bool isMobilePlatform: Qt.platform.os === "android" || Qt.platform.os === "ios"
    property string tabTitle: "ThrottleMap Pro"
    property bool isHorizontal: width > height
    property Commands vescCommands: VescIf.commands()

    // ---------------------------------------------------------------
    // Protocol constants (must mirror lisp/protocol.lisp)
    readonly property int cmdSetCell:    0x01
    readonly property int cmdSetMapRow:  0x02
    readonly property int cmdSetConfig:  0x03
    readonly property int cmdSetThr:     0x04
    readonly property int cmdSave:       0x05
    readonly property int cmdLoad:       0x06
    readonly property int cmdReset:      0x07
    readonly property int cmdReqMap:     0x08
    readonly property int cmdReqCfg:     0x09
    readonly property int cmdSetTestThr: 0x0A
    readonly property int cmdCalibrateBidir: 0x0B
    readonly property int cmdSetEnabled: 0x0C
    readonly property int cmdSetLock:    0x0D
    readonly property int cmdLockCmd:    0x0E

    readonly property int rxLive:    0x80
    readonly property int rxMapRow:  0x81
    readonly property int rxStatus: 0x82
    readonly property int rxCfgEcho: 0x83

    // Vertical axis spans -100%..+100% throttle - keep in sync with
    // map.lisp. Rows 0..9 are the brake half (10% steps), row 10 is zero
    // throttle, rows 10..30 are traction (5% steps). The duty axis is
    // 10% steps: 21x21 would not fit the EEPROM once the brake half was
    // added, and bilinear interpolation smooths duty anyway.
    readonly property int mapThrN: 31
    readonly property int mapDutyN: 21   // brake rows; traction rows store 11
    readonly property int mapThrZero: 10
    readonly property int mapCells: 451

    // Signed throttle a row stands for, and its label.
    function rowThrottle(t) {
        return t < mapThrZero ? (t - mapThrZero) / 10.0 : (t - mapThrZero) / 20.0
    }
    function rowPct(t) { return Math.round(rowThrottle(t) * 100) }
    // Ragged on purpose: for traction, duty is speed and its sign carries
    // no extra information, so the negative side is the positive side
    // mirrored and is not stored. The space pays for the traction half's
    // 5% throttle steps instead.
    function mapRowCols(t) { return t <= mapThrZero ? 21 : 11 }
    // Every view draws 21 display columns per row, duty -100%..+100%.
    // dispCol says which stored cell one of them reads.
    // The released row owns 21 columns, but its negative-duty half is only
    // ever read through the brake lookup - so with the brake map off it is
    // inert, and shows as a mirror like any other throttle row rather than
    // as an editable cell that changes nothing.
    function dispCol(t, g) {
        if (t < mapThrZero) return g
        if (t === mapThrZero) return cfgBrakeMap === 1 ? g : Math.abs(g - 10) + 10
        return Math.abs(g - 10)
    }
    // True where a display column is only a mirror of another cell.
    function isMirrored(t, g) {
        if (g >= 10) return false
        if (t > mapThrZero) return true
        return t === mapThrZero && cfgBrakeMap !== 1
    }
    function dispDuty(g) { return (g - 10) / 10.0 }
    // Signed duty a STORED column stands for
    function colDuty(t, d) { return t <= mapThrZero ? (d - 10) / 10.0 : d / 10.0 }
    function dutyPct(t, d) {
        var v = Math.round(colDuty(t, d) * 100)
        return t <= mapThrZero ? v + "%" : (v === 0 ? "0%" : "±" + v + "%")
    }
    // Nearest stored column of a row to a signed duty
    function colOf(t, duty) {
        var g = Math.max(0, Math.min(20, Math.round(duty * 10) + 10))
        return dispCol(t, g)
    }
    // Fractional row position of a signed throttle - the inverse of
    // rowThrottle, and the same two-slope axis map-lookup uses.
    function rowPosOf(thr) {
        thr = Math.max(-1, Math.min(1, thr))
        return mapThrZero + thr * (thr < 0 ? 10 : 20)
    }
    // Lowest row on screen: the brake half is hidden while it is off.
    function firstRow() { return cfgBrakeMap === 1 ? 0 : mapThrZero }
    // Signed throttle actually in effect right now, for the live dot.
    function liveSigned() { return liveBrake > 0 ? -liveBrake : liveThrottle }
    // One axis for the whole map: absolute duty, brake rows included.
    // Leftmost display column actually worth showing. With the brake map
    // off, every negative-duty cell is only a mirror of its positive twin,
    // so the whole left side is dropped rather than drawn greyed out.
    function firstCol() { return cfgBrakeMap === 1 ? 0 : 10 }
    // Fractional display column of a signed duty, 0..20
    function dutyToCol(duty) {
        var d = Math.max(-1, Math.min(1, duty))
        return (cfgBrakeMap === 1 ? d : Math.abs(d)) * 10 + 10
    }

    // ---------------------------------------------------------------
    // Map data model: flat JS array, ragged - see cellIdx
    property var mapData: initMapData()
    property var selection: ({ active:false, t0:0, d0:0, t1:0, d1:0 })
    property int curRow: 20   // for row/col copy-paste + curve picker
    property var clipboardRow: null
    property var clipboardCol: null

    // ---------------------------------------------------------------
    // Live telemetry
    property real liveThrottle: 0
    property real liveDuty: 0
    property real liveErpm: 0
    property real liveCurRel: 0
    property real liveCurA: 0
    property real liveBrake: 0
    property real liveAdcVoltage: 0
    property int pkgEnabled: 1
    property int lockState: 0
    property real lockErr: 0        // mechanical revolutions of deflection
    property real liveRpmFast: 0
    // Lock settings live in RAM on the controller: the EEPROM is full, and
    // the lock can only be engaged from here anyway.
    property int lockReason: 0      // 1 timeout 2 throttle 3 brake 4 off 5 asked
    property int lockTimeout: 60    // seconds; 0 = never lets go
    property real lockTravel: 0.25  // revolutions for full hold current
    property real lockMax: 0.15     // hold current, relative
    property real lockDamp: 0.30
    property string statusText: "Not connected"
    property string lastCmdStatus: "" // last SAVE/LOAD/RESET/REQUEST_* reply, see handleRx

    // ---------------------------------------------------------------
    // Configurator state
    property int cfgPreset: 0 // 0 custom, 1 street, 2 race, 3 wet, 4 direct
    property real cfgTorqueResp: 1.0
    property real cfgSpeedCoupling: 1.0
    property real cfgTransWidth: 0.10
    property int cfgTransShape: 1
    property real cfgHighHold: 0.6
    property real cfgEngineBrake: 0.15
    property real cfgOverrunRegen: 0.12
    property int cfgRegenCurve: 1
    // Brake half of the map: off keeps the plain proportional lever.
    property int cfgBrakeMap: 0
    // 0 regen only, 1 current no reverse, 2 current bidirectional
    property int cfgBrakeType: 0
    // Brake half generator - mirrors gen-brake-map in map.lisp
    property real cfgBrakeStr: 1.0
    property real cfgBrakeResp: 1.0
    property real cfgBrakeDep: 0.0
    property int cfgBrakeCurve: 0
    // Reverse shaping: generator parameters for the brake rows' left half
    property real cfgRevStr: 1.0
    property real cfgRevResp: 1.0
    property real cfgRevHold: 0.0
    property real cfgRevCoupling: 1.0
    property real cfgRevWidth: 0.10
    property int cfgRevShape: 1
    property real cfgRevOverrun: 0.12
    property int cfgRevCurve: 1

    property int thrSource: 0 // 0 ADC, 1 PPM, 2 UART
    property int thrInvert: 0
    property real thrDeadband: 0.02
    // Filters the duty the map reads back, in a retired throttle Min slot.
    // Nothing ever smooths the current request itself.
    property real cfgDutyFilter: 0.30
    property real thrFilter: 1.0
    property int thrBrakeMode: 0 // independent ADC2 brake channel


    function validateImport(obj) {
        if (!obj || !Array.isArray(obj.map) || obj.map.length !== mapCells) throw Error("Expected " + mapCells + " map cells")
        function range(v, lo, hi, integer) {
            if (typeof v !== "number" || !isFinite(v) || v < lo || v > hi || (integer && v !== Math.floor(v))) throw Error("Invalid value in import")
        }
        for (var i = 0; i < obj.map.length; i++) range(obj.map[i], -1, 1, false)
        if (obj.cfg) {
            var c = obj.cfg
            range(c.preset,0,4,true); range(c.torqueResp,0.3,2,false); range(c.speedCoupling,0,1.5,false)
            range(c.transWidth,0.02,0.3,false); range(c.transShape,0,3,true); range(c.highHold,0,1,false)
            range(c.engineBrake,0,0.6,false); range(c.overrunRegen,0,0.5,false); range(c.regenCurve,0,3,true)
            range(c.thrSource,0,3,true); range(c.thrInvert,0,1,true)
            range(c.thrDeadband,0,0.999,false); range(c.thrFilter,0.001,1,false)
            if (c.dutyFilter !== undefined) range(c.dutyFilter,0.001,1,false)
            if (c.thrBrakeMode !== undefined) range(c.thrBrakeMode,0,2,true)
            if (c.brakeMap !== undefined) range(c.brakeMap,0,1,true)
            if (c.brakeType !== undefined) range(c.brakeType,0,2,true)
            if (c.brakeStr !== undefined) range(c.brakeStr,0,1,false)
            if (c.brakeResp !== undefined) range(c.brakeResp,0.3,2,false)
            if (c.brakeDep !== undefined) range(c.brakeDep,0,1,false)
            if (c.revCoupling !== undefined) range(c.revCoupling,0,1.5,false)
            if (c.revWidth !== undefined) range(c.revWidth,0.02,0.3,false)
            if (c.revOverrun !== undefined) range(c.revOverrun,0,0.5,false)
            if (c.revStr !== undefined) range(c.revStr,0,1,false)
            if (c.revResp !== undefined) range(c.revResp,0.3,2,false)
            if (c.revHold !== undefined) range(c.revHold,0,1,false)
            if (c.revShape !== undefined) range(c.revShape,0,3,true)
            if (c.revCurve !== undefined) range(c.revCurve,0,3,true)
            if (c.brakeCurve !== undefined) range(c.brakeCurve,0,3,true)
        }
    }

    function initMapData() {
        var a = []
        for (var i = 0; i < mapCells; i++) a.push(0.0)
        return a
    }
    // Shared by the typed-value fields next to the Configurator/throttle
    // sliders below: accepts either "." or "," as the decimal separator,
    // clamps into the slider's own range, and returns null (caller keeps
    // the previous value) for anything that doesn't parse as a number.
    function parseClamped(text, lo, hi) {
        var v = parseFloat(String(text).replace(',', '.'))
        if (isNaN(v)) return null
        return Math.max(lo, Math.min(hi, v))
    }
    function quantizeCell(v) {
        var x = Math.max(-1, Math.min(1, v)) * 100
        return (x < 0 ? Math.ceil(x) : Math.floor(x)) / 100
    }
    function cellIdx(t, d) {
        return t <= mapThrZero ? t * 21 + d : 231 + (t - mapThrZero - 1) * 11 + d
    }
    function getCell(t, d) { return mapData[cellIdx(t, d)] }
    function setCellLocal(t, d, v) {
        v = quantizeCell(v)
        cfgPreset = 0
        var arr = mapData.slice()
        arr[cellIdx(t, d)] = v
        mapData = arr
    }

    // ---------------------------------------------------------------
    // Wire helpers (big-endian to match lispBM bufget/bufset defaults)
    function fxEnc(v) { return Math.round(v * 1000) }
    function fxDec(v) { return v / 1000.0 }

    function transmitPacket(bytesArray) {
        if (!VescIf.isPortConnected()) { statusText = "Not connected"; return }
        var buf = new ArrayBuffer(bytesArray.length)
        var view = new DataView(buf)
        for (var i = 0; i < bytesArray.length; i++) view.setUint8(i, bytesArray[i] & 0xff)
        vescCommands.sendCustomAppData(buf)
    }
    function i16Bytes(v) {
        var iv = Math.max(-32768, Math.min(32767, Math.round(v)))
        if (iv < 0) iv += 65536
        return [ (iv >> 8) & 0xff, iv & 0xff ]
    }

    function sendSetCell(t, d, v) {
        var b = [cmdSetCell, t & 0xff, d & 0xff].concat(i16Bytes(fxEnc(v)))
        sendPacket(b)
    }
    function calibrateBidirectional() { sendPacket([cmdCalibrateBidir]) }
    function sendEnabled(on) { sendPacket([cmdSetEnabled, on ? 1 : 0]) }
    function sendLockCfg() {
        var b = [cmdSetLock, lockTimeout & 0xff]
        b = b.concat(i16Bytes(Math.round(lockTravel * 1000)))
        b = b.concat(i16Bytes(Math.round(lockMax * 1000)))
        b = b.concat(i16Bytes(Math.round(lockDamp * 1000)))
        sendPacket(b)
    }
    function sendLock(on) { sendPacket([cmdLockCmd, on ? 1 : 0]) }
    function sendSetMapRow(t) {
        var b = [cmdSetMapRow, t & 0xff]
        for (var d = 0; d < 21; d++)
            b = b.concat(i16Bytes(d < mapRowCols(t) ? fxEnc(getCell(t, d)) : 0))
        sendPacket(b)
    }
    function sendAllRows() { for (var t = 0; t < mapThrN; t++) sendSetMapRow(t) }

    // Two independent regenerate flags: a traction slider must not
    // rewrite the brake rows, and a brake slider must not rewrite the
    // traction ones.
    function sendSetConfig(regenerate, regenBrake, regenRev) {
        var b = [cmdSetConfig, cfgPreset & 0xff]
        b = b.concat(i16Bytes(fxEnc(cfgTorqueResp)))
        b = b.concat(i16Bytes(fxEnc(cfgSpeedCoupling)))
        b = b.concat(i16Bytes(fxEnc(cfgTransWidth)))
        b.push(cfgTransShape & 0xff)
        b = b.concat(i16Bytes(fxEnc(cfgHighHold)))
        b = b.concat(i16Bytes(fxEnc(cfgEngineBrake)))
        b = b.concat(i16Bytes(fxEnc(cfgOverrunRegen)))
        b.push(cfgRegenCurve & 0xff)
        b.push(regenerate === false ? 0 : 1)
        b.push(cfgBrakeMap & 0xff)
        b.push(cfgBrakeType & 0xff)
        // Reserved: the ERPM switch threshold this used to carry is gone.
        b = b.concat(i16Bytes(0))
        b = b.concat(i16Bytes(fxEnc(cfgBrakeStr)))
        b = b.concat(i16Bytes(fxEnc(cfgBrakeResp)))
        b = b.concat(i16Bytes(fxEnc(cfgBrakeDep)))
        b.push(cfgBrakeCurve & 0xff)
        b.push(regenBrake === true ? 1 : 0)
        b = b.concat(i16Bytes(fxEnc(cfgRevCoupling)))
        b = b.concat(i16Bytes(fxEnc(cfgRevWidth)))
        b = b.concat(i16Bytes(fxEnc(cfgRevOverrun)))
        b = b.concat(i16Bytes(fxEnc(cfgRevStr)))
        b = b.concat(i16Bytes(fxEnc(cfgRevResp)))
        b = b.concat(i16Bytes(fxEnc(cfgRevHold)))
        b.push(cfgRevShape & 0xff)
        b.push(cfgRevCurve & 0xff)
        b.push(regenRev === true ? 1 : 0)
        sendPacket(b)
    }
    function sendSetThrottle() {
        benchValue = 0
        var b = [cmdSetThr, thrSource & 0xff, thrInvert & 0xff]
        b = b.concat(i16Bytes(fxEnc(cfgDutyFilter)))
        b = b.concat(i16Bytes(0))   // reserved: retired output ramp
        b = b.concat(i16Bytes(fxEnc(thrDeadband)))
        b = b.concat(i16Bytes(fxEnc(thrFilter)))
        b.push(thrBrakeMode & 0xff)
        sendPacket(b)
    }
    function sendSave() {
        if (pendingPacket !== null || txQueue.length > 0) { lastCmdStatus = "Wait for the current transfer before saving"; return }
        if (!mapReceived || !cfgReceived) { lastCmdStatus = "Read map and settings before saving"; return }
        if (regenDebounce.running) { regenDebounce.stop(); regenerateLocalMap() }
        if (brakeRegenDebounce.running) { brakeRegenDebounce.stop(); regenerateLocalBrake() }
        if (revRegenDebounce.running) { revRegenDebounce.stop(); regenerateLocalRev() }
        lastCmdStatus = "Uploading and saving…"
        sendSetConfig(false); sendSetThrottle(); sendAllRows(); sendPacket([cmdSave])
    }
    function sendLoad()  { sendPacket([cmdLoad]) }
    function sendReset() { sendPacket([cmdReset]) }
    function requestMap() { sendPacket([cmdReqMap]) }
    function requestCfg() { sendPacket([cmdReqCfg]) }
    function sendTestThrottle(v) {
        benchValue = v
        transmitPacket([cmdSetTestThr].concat(i16Bytes(fxEnc(v))))
    }


    property var txQueue: []
    property var pendingPacket: null
    property bool mapReceived: false
    property bool cfgReceived: false
    property var rowSeen: []
    property double lastLiveTime: 0
    // Read-back is retried from the 20 Hz live handler. Unthrottled, a
    // read-back that keeps failing re-queues the whole map twenty times a
    // second, which saturates the link and takes the interface down with
    // it - the failure looks like a frozen UI rather than a failed read.
    property double lastAutoReq: 0
    property real benchValue: 0
    onThrSourceChanged: benchValue = 0

    // One acknowledged command at a time prevents overflowing the VESC mailbox.
    function sendPacket(bytes) {
        if (!VescIf.isPortConnected()) { lastCmdStatus = "Not connected"; return }
        if (txQueue.length >= 64) { failTransfer("Too many pending commands"); return }
        txQueue.push(bytes)
        pumpTx()
    }
    function pumpTx() {
        if (pendingPacket !== null || txQueue.length === 0) return
        pendingPacket = txQueue.shift()
        if (pendingPacket[0] === cmdReqMap) { rowSeen = []; mapReceived = false }
        commandTimeout.restart()
        transmitPacket(pendingPacket)
    }
    function failTransfer(message) {
        commandTimeout.stop(); pendingPacket = null; txQueue = []
        mapReceived = false; cfgReceived = false
        lastAutoReq = Date.now()
        lastCmdStatus = message
    }
    Timer { id: commandTimeout; interval: 20000; onTriggered: failTransfer("Command timed out; read back before retrying") }
    Timer {
        interval: 500; running: true; repeat: true
        onTriggered: {
            if (!VescIf.isPortConnected() || Date.now() - lastLiveTime > 2000) {
                statusText = "Not connected"; benchValue = 0
                if (pendingPacket !== null && !VescIf.isPortConnected()) failTransfer("Disconnected during transfer")
                mapReceived = false; cfgReceived = false
            }
        }
    }
    Timer {
        interval: 100; repeat: true
        running: thrSource === 3 && benchValue !== 0 && VescIf.isPortConnected()
        onTriggered: transmitPacket([cmdSetTestThr].concat(i16Bytes(fxEnc(benchValue))))
    }

    // ---------------------------------------------------------------
    // Receive path
    Connections {
        target: vescCommands
        function onCustomAppDataReceived(data) { handleRx(data) }
    }

    function handleRx(data) {
        var view = new DataView(data)
        if (view.byteLength < 1) return
        var cmd = view.getUint8(0)
        if (cmd === rxLive) {
            if (view.byteLength !== 23) return
            lastLiveTime = Date.now()
            if ((!mapReceived || !cfgReceived) && pendingPacket === null && txQueue.length === 0
                    && Date.now() - lastAutoReq > 2000) {
                lastAutoReq = Date.now()
                requestMap(); requestCfg()
            }
            liveThrottle = fxDec(view.getInt16(1, false))
            liveDuty = fxDec(view.getInt16(3, false))
            liveErpm = view.getInt32(5, false)
            liveCurRel = fxDec(view.getInt16(9, false))
            liveCurA = view.getInt16(11, false) / 100.0
            liveBrake = fxDec(view.getInt16(13, false))
            liveAdcVoltage = view.getInt16(15, false) / 1000.0
            pkgEnabled = view.getUint8(17)
            lockState = view.getUint8(18) & 0x0f
            lockReason = view.getUint8(18) >> 4
            lockErr = view.getInt16(19, false) / 1000.0
            liveRpmFast = view.getInt16(21, false)
            statusText = "Connected"
        } else if (cmd === rxMapRow) {
            if (view.byteLength !== 44) return
            var row = view.getUint8(1)
            if (row >= mapThrN) return
            // A 31-bit mask would overflow a JS bitwise int, so count the
            // rows in a plain array instead.
            rowSeen[row] = true
            var arr = mapData.slice()
            for (var d = 0; d < mapRowCols(row); d++)
                arr[cellIdx(row, d)] = fxDec(view.getInt16(2 + d * 2, false))
            mapData = arr
        } else if (cmd === rxStatus) {
            // Separate from statusText on purpose: that one doubles as
            // the connection indicator and gets overwritten back to
            // "Connected" by the very next LIVE packet (20 Hz), so a
            // command confirmation stored there would flash for at most
            // ~50ms - effectively invisible. lastCmdStatus only changes
            // on an actual STATUS reply.
            if (view.byteLength < 3) return
            var code = view.getUint8(1), ack = view.getUint8(2)
            if (ack === cmdSetTestThr) return
            if (pendingPacket === null || ack !== pendingPacket[0]) return
            commandTimeout.stop()
            if (code >= 4) {
                failTransfer(({4:"Save failed: EEPROM readback differs", 5:"No valid saved data", 6:"Invalid command or settings", 7:"Controller command failed"})[code] || "Controller error")
                return
            }
            if (ack === cmdReqMap) {
                var got = 0
                for (var r = 0; r < mapThrN; r++) if (rowSeen[r]) got++
                mapReceived = got === mapThrN
                if (!mapReceived) { failTransfer("Incomplete map received"); return }
            }
            if (code > 0) lastCmdStatus = ["OK", "Map and settings saved and verified", "Map loaded", "Reset to defaults"][code]
            pendingPacket = null
            pumpTx()
        } else if (cmd === rxCfgEcho) {
            if (view.byteLength !== 52) return
            cfgReceived = true
            cfgPreset = view.getUint8(1)
            cfgTorqueResp = fxDec(view.getInt16(2, false))
            cfgSpeedCoupling = fxDec(view.getInt16(4, false))
            cfgTransWidth = fxDec(view.getInt16(6, false))
            cfgTransShape = view.getUint8(8)
            cfgHighHold = fxDec(view.getInt16(9, false))
            cfgEngineBrake = fxDec(view.getInt16(11, false))
            cfgOverrunRegen = fxDec(view.getInt16(13, false))
            cfgRegenCurve = view.getUint8(15)
            thrSource = view.getUint8(16)
            thrInvert = view.getUint8(17)
            cfgDutyFilter = fxDec(view.getInt16(18, false))
            thrDeadband = fxDec(view.getInt16(22, false))
            thrFilter = fxDec(view.getInt16(24, false))
            thrBrakeMode = view.getUint8(26)
            cfgBrakeMap = view.getUint8(27)
            cfgBrakeType = view.getUint8(28)
            cfgBrakeStr = fxDec(view.getInt16(31, false))
            cfgBrakeResp = fxDec(view.getInt16(33, false))
            cfgBrakeDep = fxDec(view.getInt16(35, false))
            cfgBrakeCurve = view.getUint8(37)
            cfgRevCoupling = fxDec(view.getInt16(38, false))
            cfgRevWidth = fxDec(view.getInt16(40, false))
            cfgRevOverrun = fxDec(view.getInt16(42, false))
            cfgRevStr = fxDec(view.getInt16(44, false))
            cfgRevResp = fxDec(view.getInt16(46, false))
            cfgRevHold = fxDec(view.getInt16(48, false))
            cfgRevShape = view.getUint8(50)
            cfgRevCurve = view.getUint8(51)
        }
    }

    Component.onCompleted: {
        requestMap()
        requestCfg()
    }

    // ---------------------------------------------------------------
    // Preset / map-generation logic. Lives here (on mainItem, the file's
    // root) rather than inside one tab's Component, because each
    // Component {} block has its own separate id namespace - code and
    // ids declared inside mapTabComponent aren't visible from
    // configuratorTabComponent or vice versa. Functions/properties on
    // mainItem ARE visible from every Component in this file (they're
    // captured in each Component's lexical/creation scope), so both the
    // Map tab and the Configurator tab can drive the exact same preset
    // and map-generation controls from here.
    property var presets: [
        { name: "Custom",         id: 0 },
        { name: "Thermal Street", id: 1 },
        { name: "Thermal Race",   id: 2 },
        { name: "Wet",            id: 3 },
        { name: "Direct Electric",id: 4 }
    ]

    function applyPresetValues(id) {
        if (id === 1) { // Thermal Street
            cfgTorqueResp = 0.85; cfgSpeedCoupling = 1.0; cfgTransWidth = 0.10
            cfgTransShape = 1; cfgHighHold = 0.55; cfgEngineBrake = 0.15
            cfgOverrunRegen = 0.12; cfgRegenCurve = 1
        } else if (id === 2) { // Thermal Race
            cfgTorqueResp = 1.0; cfgSpeedCoupling = 0.9; cfgTransWidth = 0.06
            cfgTransShape = 3; cfgHighHold = 0.9; cfgEngineBrake = 0.08
            cfgOverrunRegen = 0.06; cfgRegenCurve = 2
        } else if (id === 3) { // Wet
            cfgTorqueResp = 0.6; cfgSpeedCoupling = 1.1; cfgTransWidth = 0.16
            cfgTransShape = 1; cfgHighHold = 0.35; cfgEngineBrake = 0.10
            cfgOverrunRegen = 0.05; cfgRegenCurve = 1
        } else if (id === 4) { // Direct Electric
            cfgTorqueResp = 1.0; cfgSpeedCoupling = 0.0; cfgTransWidth = 0.02
            cfgTransShape = 0; cfgHighHold = 1.0; cfgEngineBrake = 0.02
            cfgOverrunRegen = 0.0; cfgRegenCurve = 0
        }
        cfgPreset = id
    }

    // Local (QML-side) mirror of gen-thermal-map from map.lisp, used so
    // the heatmap updates instantly without waiting on a round trip; the
    // authoritative regeneration still happens on the VESC when
    // SET_CONFIG is received with preset > 0.
    function thermalPeak(thr, torqueResp, highHold) {
        var base = Math.pow(thr, torqueResp)
        var smooth = Math.max(0, Math.min(1, (thr - 0.6) / 0.4))
        return base + (thr - base) * highHold * smooth
    }
    function shapeCurve(p, shape) {
        if (shape === 0) return p
        if (shape === 1) return p*p
        if (shape === 2) return 1 - Math.pow(1-p, 3)
        return Math.pow(p, 4)
    }
    // Dragging a slider fires onMoved many times per second; calling
    // regenerateLocalMap() straight from onMoved recomputes all 441
    // cells and forces the heatmap/curve/iso Canvases to fully redraw
    // on every single tick of the drag, which is what was actually
    // causing the reported lag - not the drawing itself (that part was
    // already split into cheap/expensive layers earlier). Route slider
    // handlers through requestRegen() instead: it only restarts a short
    // timer, so the real recompute+redraw happens once, shortly after
    // the user stops moving the slider, not on every pixel of the drag.
    property Timer regenDebounce: Timer { interval: 60; onTriggered: regenerateLocalMap() }
    function requestRegen() { regenDebounce.restart() }
    property Timer brakeRegenDebounce: Timer { interval: 60; onTriggered: { regenerateLocalBrake(); sendSetConfig(false, true, false) } }
    function requestBrakeRegen() { brakeRegenDebounce.restart() }
    property Timer revRegenDebounce: Timer { interval: 60; onTriggered: { regenerateLocalRev(); sendSetConfig(false, false, true) } }
    function requestRevRegen() { revRegenDebounce.restart() }

    // QML mirror of gen-rev-half: the traction law negated, over reverse
    // duty, with its own eight settings.
    function regenerateLocalRev() {
        var arr = mapData.slice()
        for (var bi = 0; bi < mapThrZero; bi++) {
            var lever = (mapThrZero - bi) / 10.0
            var peak = cfgRevStr * thermalPeak(lever, cfgRevResp, cfgRevHold)
            var balance = Math.max(0, Math.min(1, lever * cfgRevCoupling))
            var start = Math.max(0, Math.min(1, balance - cfgRevWidth))
            for (var di = 0; di < 11; di++) {
                var rev = (10 - di) / 10.0
                var val
                if (cfgRevCoupling === 0) val = -peak
                else if (rev <= start) val = -peak
                else if (rev <= balance) {
                    var pr = (rev - start) / Math.max(0.001, balance - start)
                    val = -peak * (1 - shapeCurve(pr, cfgRevShape))
                } else {
                    var over = (rev - balance) / Math.max(0.001, 1 - balance)
                    val = cfgRevOverrun * Math.pow(Math.max(0, Math.min(1, over)), 1 + cfgRevCurve)
                }
                arr[cellIdx(bi, di)] = quantizeCell(val)
            }
        }
        // Row 10 is this region's zero-lever edge: peak and balance are
        // both zero there, so the reverse law puts every column in its
        // runaway branch, continuous with the -10% row above it.
        for (var mi = 0; mi < 10; mi++) {
            var mrev = (10 - mi) / 10.0
            arr[cellIdx(mapThrZero, mi)] =
                quantizeCell(cfgRevOverrun * Math.pow(mrev, 1 + cfgRevCurve))
        }
        mapData = arr
    }

    // QML mirror of gen-brake-map: braking demand against forward speed.
    function regenerateLocalBrake() {
        var arr = mapData.slice()
        for (var bi = 0; bi < mapThrZero; bi++) {
            var lever = (mapThrZero - bi) / 10.0
            var peak = cfgBrakeStr * Math.pow(lever, cfgBrakeResp)
            for (var di = 11; di < 21; di++) {
                var duty = (di - 10) / 10.0
                var speed = (1 - cfgBrakeDep) + cfgBrakeDep * Math.pow(duty, 1 + cfgBrakeCurve)
                arr[cellIdx(bi, di)] = quantizeCell(-peak * Math.max(0, Math.min(1, speed)))
            }
        }
        mapData = arr
    }

    // Traction half only: the brake rows are hand territory and no
    // slider ever rewrites them (gen-thermal-map in map.lisp matches).
    function regenerateLocalMap() {
        var arr = mapData.slice()
        for (var ti = 0; ti < 21; ti++) {
            var thr = ti / 20.0
            var peak = thermalPeak(thr, cfgTorqueResp, cfgHighHold)
            var balanceDuty = Math.max(0, Math.min(1, thr * cfgSpeedCoupling))
            for (var di = 0; di < 11; di++) {
                var duty = di / 10.0
                var val
                if (thr < 0.02) {
                    val = -cfgEngineBrake * Math.pow(duty, 1 + cfgRegenCurve)
                } else if (cfgSpeedCoupling === 0) {
                    val = peak
                } else {
                    var start = Math.max(0, balanceDuty - cfgTransWidth)
                    if (duty <= start) val = peak
                    else if (duty <= balanceDuty) {
                        var p = (duty - start) / Math.max(0.001, balanceDuty - start)
                        val = peak * (1 - shapeCurve(p, cfgTransShape))
                    } else {
                        var over = (duty - balanceDuty) / Math.max(0.001, 1 - balanceDuty)
                        val = -cfgOverrunRegen * Math.pow(Math.max(0,Math.min(1,over)), 1 + cfgRegenCurve)
                    }
                }
                arr[cellIdx(ti + mapThrZero, ti === 0 ? di + 10 : di)] = quantizeCell(val)
            }
        }
        mapData = arr
    }

    // ---------------------------------------------------------------
    // Color scale: -1..0..+1 -> blue/purple .. gray .. green/yellow/orange/red
    function valueColor(v) {
        v = Math.max(-1, Math.min(1, v))
        if (v >= 0) {
            var stops = [
                { p: 0.0,  c: Qt.rgba(0.42, 0.45, 0.50, 1) }, // neutral gray at 0
                { p: 0.25, c: Qt.rgba(0.20, 0.70, 0.35, 1) }, // green
                { p: 0.55, c: Qt.rgba(0.90, 0.80, 0.15, 1) }, // yellow
                { p: 0.80, c: Qt.rgba(0.95, 0.55, 0.10, 1) }, // orange
                { p: 1.0,  c: Qt.rgba(0.90, 0.15, 0.15, 1) }  // red
            ]
            return lerpStops(stops, v)
        } else {
            var stopsN = [
                { p: 0.0,  c: Qt.rgba(0.42, 0.45, 0.50, 1) },
                { p: 0.40, c: Qt.rgba(0.25, 0.45, 0.85, 1) }, // blue
                { p: 1.0,  c: Qt.rgba(0.55, 0.20, 0.75, 1) }  // violet
            ]
            return lerpStops(stopsN, -v)
        }
    }
    function lerpStops(stops, p) {
        for (var i = 0; i < stops.length - 1; i++) {
            if (p >= stops[i].p && p <= stops[i+1].p) {
                var t = (p - stops[i].p) / (stops[i+1].p - stops[i].p || 1)
                var a = stops[i].c, b = stops[i+1].c
                return Qt.rgba(a.r + (b.r-a.r)*t, a.g + (b.g-a.g)*t, a.b + (b.b-a.b)*t, 1)
            }
        }
        return stops[stops.length-1].c
    }

    // Pane (not a plain Rectangle) because it has a `font` property that
    // cascades to every descendant Label/Button/ComboBox/etc that doesn't
    // set its own font.pixelSize - a bare Item/Rectangle has no such
    // property at all, and assigning font.* to one is a QML load error
    // (this is why an earlier build failed to load entirely).
    Pane {
        // Capping width to Screen.width made mobile truncation WORSE
        // (confirmed), meaning Screen.width is measured in a different
        // unit/scale than mainItem.parent.width on that host (a DPI
        // mismatch) rather than the two agreeing on "the real screen
        // width" - reverted. Back to plain anchors.fill: parent, same as
        // Refloat, until the debug readout below gives real numbers to
        // work from instead of another guess.
        anchors.fill: parent
        // Kept as a safety net regardless: switching to a different VESC
        // Tool tab on a phone once left a leftover render of this page's
        // heatmap Canvas visibly floating over the other tab. Costs
        // nothing when sizes are already correct.
        clip: true
        padding: 0
        // Smaller on mobile: at 22px, the 4 TabButtons (Map/Curves/3D/
        // Configurator) don't fit a phone-width TabBar, pushing
        // Configurator out of reach entirely once content is clipped to
        // our own bounds (see the Pane's clip: true below).
        font.pixelSize: mainItem.isMobilePlatform ? 15 : 22
        background: Rectangle { color: "#15181d" }

        ColumnLayout {
            anchors.fill: parent
            anchors.margins: 8
            spacing: 6

            RowLayout {
                id: headerRow
                Layout.fillWidth: true
                // This row was never audited for the same overflow class
                // as everything below it - a plain Label defaults its
                // Layout.minimumWidth to its own full text, so 4-5 fixed
                // labels side by side here (title + build + debug + dot +
                // status) could force this row, and therefore the whole
                // page above the tab bar, wider than a phone screen no
                // matter what gets fixed further down. Every label here
                // now either elides or is deliberately kept very short.
                Label {
                    text: "ThrottleMap Pro Trimap"
                    font.pixelSize: 30; font.bold: true; color: "#e8e8e8"
                    Layout.fillWidth: true
                    elide: Text.ElideRight
                }
                // Bump buildMarker on every edit to this file so a stale/
                // cached install is immediately obvious instead of
                // ambiguous - "still the same" is either a real no-op fix
                // or a cache; this number tells them apart at a glance.
                Label { text: "b" + buildMarker; color: "#f80"; font.bold: true }
                Label {
                    visible: pkgEnabled === 0
                    text: "OFF"; color: "#ff5555"; font.bold: true
                }
                Label {
                    visible: lockState === 1
                    text: "LOCK"; color: "#00e5ff"; font.bold: true
                }
                Label {
                    font.pixelSize: 10; color: "#0f0"
                    Layout.maximumWidth: 160
                    elide: Text.ElideRight
                    text: "w" + Math.round(mainItem.width) +
                          "/p" + (mainItem.parent ? Math.round(mainItem.parent.width) : 0) +
                          "/s" + Math.round(Screen.width)
                }
                Rectangle {
                    width: 10; height: 10; radius: 5
                    color: statusText === "Connected" ? "#33cc66" : "#888888"
                }
            }

            // A package that commands nothing looks exactly like a package
            // that is broken. Say which, loudly.
            Rectangle {
                visible: pkgEnabled === 0
                Layout.fillWidth: true
                implicitHeight: offLabel.implicitHeight + 10
                color: "#5a1a1a"; border.color: "#ff5555"; border.width: 1
                radius: 3
                Label {
                    id: offLabel
                    anchors.fill: parent
                    anchors.margins: 5
                    horizontalAlignment: Text.AlignHCenter
                    verticalAlignment: Text.AlignVCenter
                    wrapMode: Text.WordWrap
                    text: "DISABLED - no motor command is being sent. Config tab, Master switch."
                    color: "#ffbbbb"; font.bold: true; font.pixelSize: 14
                }
            }

            TabBar {
                id: tabBar
                Layout.fillWidth: true
                Material.background: "#1d2127"
                TabButton { text: "Map" }
                TabButton { text: "Curves" }
                TabButton { text: "3D" }
                TabButton { text: "Lock" }
                TabButton { text: "Config" }
            }

            StackLayout {
                id: stackLayout
                Layout.fillWidth: true
                Layout.fillHeight: true
                currentIndex: tabBar.currentIndex

                // Everything below is defined inline (not as separate QML
                // component files): a VESC Package ships exactly one qml
                // file (see pkgdesc.qml / the packager), so there is no
                // supported way to `import` a second local .qml type the
                // way lisp/*.lisp files can be imported. Splitting the UI
                // into named `property Component` blocks inside this one
                // file keeps things readable without fighting that
                // constraint - see docs/architecture.md.
                Loader { sourceComponent: mapTabComponent }
                Loader { sourceComponent: curvesTabComponent }
                Loader { sourceComponent: iso3DTabComponent }
                Loader { sourceComponent: lockTabComponent }
                Loader { sourceComponent: configuratorTabComponent }
            }
        }
    }

    // =================================================================
    // Tab: Map (heatmap + live dot + manual cell/row/col editing)
    // =================================================================
    Component {
        id: mapTabComponent
        Item {
            id: mapTab
            // Deliberately NOT anchors.fill: parent - in this host, that
            // resolved to the item's own pre-existing (minimal) size
            // instead of the real panel size. Binding directly to the
            // StackLayout's own geometry (proven correct: the TabBar
            // above it fills the whole panel width) sidesteps whatever
            // is off about the Loader/parent chain in between.
            width: stackLayout.width
            height: stackLayout.height
            property int hoverT: -1
            property int hoverD: -1

            // Explicit x/y/width/height instead of ColumnLayout/anchors:
            // this host has repeatedly shown surprising results with
            // Layout-negotiated sizing (see git history), including the
            // heatmap growing out of frame once real telemetry started
            // updating it. Two fixed zones, computed directly from
            // mapTab's own (now known-good) size, removes any chance of
            // a Layout feedback loop.
            property real heatmapH: Math.max(280, Math.round(mapTab.height * 0.55))
            property real controlsY: heatmapH + 8
            property real controlsH: Math.max(160, mapTab.height - controlsY - 4)

            Rectangle {
                id: heatmapBox
                x: 0; y: 0
                width: mapTab.width
                height: mapTab.heatmapH
                    color: "#0e1013"
                    border.color: "#333"
                    radius: 4

                    // Two stacked canvases instead of one: redrawing the
                    // full 21x21 grid (441 cells, each with a fillRect +
                    // strokeRect + measured fillText) on every single LIVE
                    // telemetry packet (~20 Hz, or every pixel of a
                    // dragged bench-throttle slider) was the real cause of
                    // the reported lag. The grid only actually changes
                    // when mapData/selection changes (rare - editing,
                    // preset regen); the live dot changes constantly but
                    // is cheap on its own (clear + one small circle) once
                    // it isn't dragging the whole grid down with it.
                    Canvas {
                        id: heatmap
                        anchors.fill: parent
                        anchors.margins: 24
                        property int rowBase: firstRow()
                        property int rowCount: mapThrN - rowBase
                        // One shared duty axis so the two halves line up
                        // cell for cell. Each column takes a full slice of
                        // the width rather than being centred on its own
                        // value, which used to cut the edge cells in half.
                        property int colBase: firstCol()
                        property int colCount: 21 - colBase
                        property real cw: width / colCount
                        property real ch: height / rowCount

                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            try {
                                for (var t = rowBase; t < mapThrN; t++) {
                                    for (var g = colBase; g < 21; g++) {
                                        var d = dispCol(t, g)
                                        var v = getCell(t, d)
                                        var col = valueColor(v)
                                        var mirrored = isMirrored(t, g)
                                        ctx.fillStyle = Qt.rgba(col.r, col.g, col.b, 1)
                                        var y = height - (t - rowBase + 1) * ch
                                        var x = (g - colBase) * cw
                                        var selected = isSelected(t, d)
                                        ctx.fillRect(x, y, cw - 1, ch - 1)
                                        // Dim what is only a mirror of the
                                        // other side, so the editable cells
                                        // are obvious at a glance.
                                        if (mirrored) {
                                            ctx.fillStyle = "rgba(14,16,19,0.55)"
                                            ctx.fillRect(x, y, cw - 1, ch - 1)
                                        }
                                        if (selected) {
                                            ctx.strokeStyle = "#ffffff"
                                            ctx.lineWidth = 2
                                            ctx.strokeRect(x+1, y+1, cw - 3, ch - 3)
                                        }
                                        if (cw > 30 && !mirrored) {
                                            ctx.fillStyle = Math.abs(v) > 0.5 ? "#111" : "#eee"
                                            ctx.font = Math.max(10, Math.min(15, cw * 0.32)) + "px sans-serif"
                                            ctx.textAlign = "center"
                                            ctx.fillText(v.toFixed(2), x + cw/2, y + ch/2 + 4)
                                        }
                                    }
                                }
                            } catch (e) {
                                ctx.fillStyle = "#ff5555"
                                ctx.font = "15px sans-serif"
                                ctx.textAlign = "left"
                                ctx.fillText("Draw error: " + e, 8, 20)
                            }
                        }

                        Connections { target: mainItem; function onMapDataChanged() { heatmap.requestPaint() } }
                        Connections { target: mainItem; function onSelectionChanged() { heatmap.requestPaint() } }
                        Connections { target: mainItem; function onCfgBrakeMapChanged() { heatmap.requestPaint() } }
                        onRowBaseChanged: requestPaint()
                        onColBaseChanged: requestPaint()
                        onWidthChanged: requestPaint()
                        onHeightChanged: requestPaint()
                        Component.onCompleted: requestPaint()

                        function cellFromPos(mx, my) {
                            var t = rowBase + Math.floor((height - my) / ch)
                            t = Math.max(rowBase, Math.min(mapThrN-1, t))
                            // Snap to a display column, then to the cell it
                            // reads - on a traction row both mirrored halves
                            // are the same cell.
                            var g = colBase + Math.max(0, Math.min(colCount - 1,
                                        Math.floor(mx / cw)))
                            return { t: t, d: dispCol(t, g) }
                        }
                    }

                    // Cheap overlay, repainted on every LIVE packet: just
                    // the moving dot, transparent everywhere else so the
                    // grid Canvas underneath shows through.
                    Canvas {
                        id: heatmapDot
                        anchors.fill: heatmap
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var lx = (dutyToCol(liveDuty) - heatmap.colBase + 0.5) * heatmap.cw
                            // Centre of the band the live throttle sits in,
                            // so the dot lines up with the cell it reads.
                            var ly = height - (rowPosOf(liveSigned()) - heatmap.rowBase + 0.5) * heatmap.ch
                            ctx.beginPath()
                            ctx.arc(lx, ly, 6, 0, 2*Math.PI)
                            ctx.fillStyle = "#00e5ff"
                            ctx.fill()
                            ctx.strokeStyle = "#003"
                            ctx.stroke()
                        }
                        Connections { target: mainItem; function onLiveDutyChanged() { heatmapDot.requestPaint() } }
                        Connections { target: mainItem; function onLiveThrottleChanged() { heatmapDot.requestPaint() } }
                        Connections { target: mainItem; function onLiveBrakeChanged() { heatmapDot.requestPaint() } }
                        onWidthChanged: requestPaint()
                        onHeightChanged: requestPaint()
                        Component.onCompleted: requestPaint()
                    }

                    MouseArea {
                        anchors.fill: heatmap
                        onPressed: (mouse) => {
                            var c = heatmap.cellFromPos(mouse.x, mouse.y)
                            selection = { active: true, t0: c.t, d0: c.d, t1: c.t, d1: c.d }
                            pickCell(c)
                        }
                        onPositionChanged: (mouse) => {
                            if (!selection.active) return
                            var c = heatmap.cellFromPos(mouse.x, mouse.y)
                            selection = { active: true, t0: selection.t0, d0: selection.d0, t1: c.t, d1: c.d }
                        }
                        onClicked: (mouse) => {
                            var c = heatmap.cellFromPos(mouse.x, mouse.y)
                            pickCell(c)
                        }
                    }

                    // axis labels
                    Label { text: cfgBrakeMap === 1 ? "Brake -100%  /  Duty -100%" : "Throttle 0%  /  Duty 0%"; color: "#888"; anchors.left: parent.left; anchors.bottom: parent.bottom; anchors.margins: 4 }
                    Label {
                        text: cfgBrakeMap === 1 ? "Dimmed = mirror of the other side, same cells" : ""
                        color: "#555"; font.pixelSize: 15
                        anchors.horizontalCenter: parent.horizontalCenter; anchors.top: parent.top; anchors.margins: 4
                    }
                    Label { visible: cfgBrakeMap === 1; text: "Duty 0%"; color: "#666"; anchors.horizontalCenter: parent.horizontalCenter; anchors.bottom: parent.bottom; anchors.margins: 4 }
                    Label { text: "Duty +100%"; color: "#888"; anchors.right: parent.right; anchors.bottom: parent.bottom; anchors.margins: 4 }
                    Label { text: "Throttle +100%"; color: "#888"; anchors.left: parent.left; anchors.top: parent.top; anchors.margins: 4 }
                }

                Flickable {
                    id: mapControlsFlick
                    x: 0; y: mapTab.controlsY
                    width: mapTab.width
                    height: mapTab.controlsH
                    clip: true
                    contentWidth: width
                    contentHeight: mapControlsCol.implicitHeight + 16
                    boundsBehavior: Flickable.StopAtBounds
                    ScrollBar.vertical: ScrollBar {
                        policy: ScrollBar.AlwaysOn
                        width: 14
                    }
                    ColumnLayout {
                        id: mapControlsCol
                        width: mapControlsFlick.width - 20
                        spacing: 6

                    Label { text: "Live"; font.bold: true; color: "#ddd" }
                    GridLayout {
                        columns: 2
                        Label { text: "Throttle" ; color: "#aaa"}
                        Label { text: (liveThrottle*100).toFixed(1) + " %"; color: "#fff" }
                        Label { text: "Duty"; color: "#aaa" }
                        Label { text: (liveDuty*100).toFixed(1) + " %"; color: "#fff" }
                        Label { text: "ERPM"; color: "#aaa" }
                        Label { text: liveErpm.toFixed(0); color: "#fff" }
                        Label { text: "Current Rel"; color: "#aaa" }
                        Label { text: liveCurRel.toFixed(2); color: "#fff" }
                        Label { text: "Motor A"; color: "#aaa" }
                        Label { text: liveCurA.toFixed(1) + " A"; color: "#fff" }
                        Label { visible: thrBrakeMode !== 0; text: "Brake"; color: "#aaa" }
                        Label { visible: thrBrakeMode !== 0; text: (liveBrake*100).toFixed(1) + " %"; color: "#fff" }
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    // Moved here from the Configurator tab: preset + the 8
                    // map-shaping sliders, right next to the heatmap so
                    // dragging them shows their effect immediately.
                    Label { text: "1 - Traction  (top half)"; font.bold: true; color: "#ddd" }
                    Flow {
                        Layout.fillWidth: true
                        spacing: 6
                        ComboBox {
                            id: presetComboMap
                            width: 180
                            model: presets.map(function(p){ return p.name })
                            currentIndex: cfgPreset
                            onActivated: (idx) => {
                                applyPresetValues(presets[idx].id)
                                regenerateLocalMap()
                                sendSetConfig(); requestMap()
                            }
                        }
                        Button {
                            text: "Regenerate map"
                            onClicked: { regenDebounce.stop(); regenerateLocalMap(); sendSetConfig(); requestMap() }
                        }
                    }
                    // Stacked (label+value row, slider below), not a
                    // rigid 3-column grid: a GridLayout's columns each
                    // need enough room for their widest cell at once and
                    // refuse to shrink past that - confirmed on real
                    // hardware as the actual cause of content shifting
                    // out of frame below a certain window/screen width,
                    // on desktop as much as on mobile. A slider alone on
                    // its own full-width row has no such minimum.
                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 10

                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Torque response"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgTorqueResp.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.3, 2.0)
                                        if (v !== null) { cfgTorqueResp = v; cfgPreset = 0; requestRegen() }
                                        text = Qt.binding(function() { return cfgTorqueResp.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.3; to: 2.0; value: cfgTorqueResp; onMoved: { cfgTorqueResp = value; cfgPreset = 0; requestRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Speed coupling"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgSpeedCoupling.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.5)
                                        if (v !== null) { cfgSpeedCoupling = v; cfgPreset = 0; requestRegen() }
                                        text = Qt.binding(function() { return cfgSpeedCoupling.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.5; value: cfgSpeedCoupling; onMoved: { cfgSpeedCoupling = value; cfgPreset = 0; requestRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Transition width"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    // Shown/typed as a percentage (2-30%), matching the label.
                                    text: (cfgTransWidth*100).toFixed(0) + " %"
                                    onEditingFinished: {
                                        var v = parseClamped(text, 2, 30)
                                        if (v !== null) { cfgTransWidth = v/100.0; cfgPreset = 0; requestRegen() }
                                        text = Qt.binding(function() { return (cfgTransWidth*100).toFixed(0) + " %" })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.02; to: 0.30; value: cfgTransWidth; onMoved: { cfgTransWidth = value; cfgPreset = 0; requestRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            Label { text: "Transition shape"; color: "#ccc" }
                            ComboBox {
                                Layout.fillWidth: true
                                model: ["Linear", "Progressive", "Exponential", "Late/abrupt"]
                                currentIndex: cfgTransShape
                                onActivated: (idx) => { cfgTransShape = idx; cfgPreset = 0; regenerateLocalMap() }
                            }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "High throttle hold"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgHighHold.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.0)
                                        if (v !== null) { cfgHighHold = v; cfgPreset = 0; requestRegen() }
                                        text = Qt.binding(function() { return cfgHighHold.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.0; value: cfgHighHold; onMoved: { cfgHighHold = value; cfgPreset = 0; requestRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Engine braking"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgEngineBrake.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 0.6)
                                        if (v !== null) { cfgEngineBrake = v; cfgPreset = 0; requestRegen() }
                                        text = Qt.binding(function() { return cfgEngineBrake.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 0.6; value: cfgEngineBrake; onMoved: { cfgEngineBrake = value; cfgPreset = 0; requestRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Overrun regen"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgOverrunRegen.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 0.5)
                                        if (v !== null) { cfgOverrunRegen = v; cfgPreset = 0; requestRegen() }
                                        text = Qt.binding(function() { return cfgOverrunRegen.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 0.5; value: cfgOverrunRegen; onMoved: { cfgOverrunRegen = value; cfgPreset = 0; requestRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            Label { text: "Regen curve"; color: "#ccc" }
                            ComboBox {
                                Layout.fillWidth: true
                                model: ["Linear", "Progressive", "Late"]
                                currentIndex: cfgRegenCurve
                                onActivated: (idx) => { cfgRegenCurve = idx; cfgPreset = 0; regenerateLocalMap() }
                            }
                        }
                    }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333"; visible: cfgBrakeMap === 1 }

                    // Second generator, for the brake half only. Separate
                    // from the traction sliders above on purpose: each
                    // half regenerates on its own flag, so shaping one
                    // never discards hand edits made to the other.
                    ColumnLayout {
                        visible: cfgBrakeMap === 1
                        Layout.fillWidth: true
                        spacing: 10

                        Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }
                        Label { text: "2 - Brake  (bottom right: braking against speed)"; font.bold: true; color: "#ddd" }
                        Label {
                            text: "A flat plateau by default: -10% lever is -10% current at any speed. Only the shape settings here, since braking rarely needs a balance point - reverse, below, gets the full set."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        Flow {
                            Layout.fillWidth: true
                            spacing: 6
                            Button {
                                text: "Regenerate brake"
                                onClicked: { brakeRegenDebounce.stop(); regenerateLocalBrake(); sendSetConfig(false, true, false) }
                            }
                            Button {
                                text: "Default brake"
                                onClicked: {
                                    cfgBrakeStr = 1.0; cfgBrakeResp = 1.0
                                    cfgBrakeDep = 0.0; cfgBrakeCurve = 0
                                    brakeRegenDebounce.stop(); regenerateLocalBrake(); sendSetConfig(false, true, false)
                                }
                            }
                        }

                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Brake strength at full lever"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgBrakeStr.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.0)
                                        if (v !== null) { cfgBrakeStr = v; requestBrakeRegen() }
                                        text = Qt.binding(function() { return cfgBrakeStr.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.0; value: cfgBrakeStr; onMoved: { cfgBrakeStr = value; requestBrakeRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Lever response"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgBrakeResp.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.3, 2.0)
                                        if (v !== null) { cfgBrakeResp = v; requestBrakeRegen() }
                                        text = Qt.binding(function() { return cfgBrakeResp.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.3; to: 2.0; value: cfgBrakeResp; onMoved: { cfgBrakeResp = value; requestBrakeRegen() } }
                        }
                        Label {
                            text: "Below 1.00 the first part of the lever travel bites harder; above 1.00 it stays soft and firms up at the end."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Speed dependence"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgBrakeDep.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.0)
                                        if (v !== null) { cfgBrakeDep = v; requestBrakeRegen() }
                                        text = Qt.binding(function() { return cfgBrakeDep.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.0; value: cfgBrakeDep; onMoved: { cfgBrakeDep = value; requestBrakeRegen() } }
                        }
                        Label {
                            text: "0.00 (default) brakes the same at every speed. Raise it to fade braking out towards a standstill, which keeps regen from grabbing at walking pace."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            Label { text: "Speed curve"; color: "#ccc" }
                            ComboBox {
                                Layout.fillWidth: true
                                model: ["Linear", "Squared", "Cubed", "Fourth power"]
                                currentIndex: cfgBrakeCurve
                                onActivated: (idx) => { cfgBrakeCurve = idx; requestBrakeRegen() }
                            }
                        }
                    }

                    ColumnLayout {
                        visible: cfgBrakeMap === 1
                        Layout.fillWidth: true
                        spacing: 10

                        Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }
                        Label { text: "3 - Reverse  (bottom left: negative duty)"; font.bold: true; color: "#ddd" }
                        Label {
                            text: "The traction law again, mirrored: the lever is the throttle, reverse duty is the speed, and each lever position settles at its own reverse speed instead of accelerating backwards indefinitely. Only a bidirectional brake ever reaches these columns."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        Flow {
                            Layout.fillWidth: true
                            spacing: 6
                            Button {
                                text: "Regenerate reverse"
                                onClicked: { revRegenDebounce.stop(); regenerateLocalRev(); sendSetConfig(false, false, true) }
                            }
                            Button {
                                text: "Default reverse"
                                onClicked: {
                                    cfgRevStr = 1.0; cfgRevResp = 1.0; cfgRevHold = 0.0
                                    cfgRevCoupling = 1.0; cfgRevWidth = 0.10; cfgRevShape = 1
                                    cfgRevOverrun = 0.12; cfgRevCurve = 1
                                    revRegenDebounce.stop(); regenerateLocalRev(); sendSetConfig(false, false, true)
                                }
                            }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Reverse torque at full lever"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgRevStr.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.0)
                                        if (v !== null) { cfgRevStr = v; requestRevRegen() }
                                        text = Qt.binding(function() { return cfgRevStr.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.0; value: cfgRevStr; onMoved: { cfgRevStr = value; requestRevRegen() } }
                        }
                        Label {
                            text: "Caps reverse torque below the VESC own current limit. Lower it to make reverse deliberately gentler than braking."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Lever response"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgRevResp.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.3, 2.0)
                                        if (v !== null) { cfgRevResp = v; requestRevRegen() }
                                        text = Qt.binding(function() { return cfgRevResp.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.3; to: 2.0; value: cfgRevResp; onMoved: { cfgRevResp = value; requestRevRegen() } }
                        }
                        Label {
                            text: "Below 1.00 the first part of the lever travel pulls harder; above 1.00 it stays soft and firms up at the end."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "High lever hold"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgRevHold.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.0)
                                        if (v !== null) { cfgRevHold = v; requestRevRegen() }
                                        text = Qt.binding(function() { return cfgRevHold.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.0; value: cfgRevHold; onMoved: { cfgRevHold = value; requestRevRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Reverse speed coupling"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgRevCoupling.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 1.5)
                                        if (v !== null) { cfgRevCoupling = v; requestRevRegen() }
                                        text = Qt.binding(function() { return cfgRevCoupling.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 1.5; value: cfgRevCoupling; onMoved: { cfgRevCoupling = value; requestRevRegen() } }
                        }
                        Label {
                            text: "The reverse duty each lever position settles at: 1.00 means 30% lever backs up to 30% duty and then stops pulling. 0.00 removes the balance and it keeps accelerating backwards."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Transition width"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgRevWidth.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.02, 0.30)
                                        if (v !== null) { cfgRevWidth = v; requestRevRegen() }
                                        text = Qt.binding(function() { return cfgRevWidth.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.02; to: 0.30; value: cfgRevWidth; onMoved: { cfgRevWidth = value; requestRevRegen() } }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            Label { text: "Transition shape"; color: "#ccc" }
                            ComboBox {
                                Layout.fillWidth: true
                                model: ["Linear", "Squared", "Late", "Fourth power"]
                                currentIndex: cfgRevShape
                                onActivated: (idx) => { cfgRevShape = idx; requestRevRegen() }
                            }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Runaway hold"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: cfgRevOverrun.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.0, 0.50)
                                        if (v !== null) { cfgRevOverrun = v; requestRevRegen() }
                                        text = Qt.binding(function() { return cfgRevOverrun.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.0; to: 0.50; value: cfgRevOverrun; onMoved: { cfgRevOverrun = value; requestRevRegen() } }
                        }
                        Label {
                            text: "Forward torque past the balance point, to pull a reverse that is running away downhill back down to it."
                            color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            Label { text: "Runaway curve"; color: "#ccc" }
                            ComboBox {
                                Layout.fillWidth: true
                                model: ["Linear", "Progressive", "Late", "Fourth power"]
                                currentIndex: cfgRevCurve
                                onActivated: (idx) => { cfgRevCurve = idx; requestRevRegen() }
                            }
                        }
                    }


                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    // Bench throttle here too (as well as on the
                    // Configurator tab, where the source itself is
                    // picked) so you can drag it while watching the live
                    // dot move across the map you just shaped above.
                    ColumnLayout {
                        visible: thrSource === 3
                        Layout.fillWidth: true
                        Label { text: "Bench throttle (test source)"; font.bold: true; color: "#ddd" }
                        RowLayout {
                            Layout.fillWidth: true
                            Slider {
                                id: benchThrottleMap
                                Layout.fillWidth: true
                                from: cfgBrakeMap === 1 ? -1 : 0; to: 1
                                value: mainItem.benchValue
                                onMoved: sendTestThrottle(value)
                                onPressedChanged: if (!pressed) sendTestThrottle(value)
                            }
                            Label { text: (benchThrottleMap.value*100).toFixed(0) + " %"; color: "#fff" }
                            Button {
                                text: "STOP"
                                Material.background: "#b23b3b"
                                onClicked: { benchThrottleMap.value = 0; sendTestThrottle(0) }
                            }
                        }
                    }
                    Label {
                        visible: thrSource !== 3
                        text: "Throttle source is not set to Test - pick it on the Configurator tab to bench-drive the map from here without ADC/PPM/UART hardware."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Selected cell"; font.bold: true; color: "#ddd" }
                    Label {
                        color: "#fff"
                        text: hoverT >= 0
                            ? (hoverT < mapThrZero ? "Brake " : "Thr ") + Math.abs(rowPct(hoverT)) + "%  Duty "
                              + dutyPct(hoverT, hoverD) + " duty\nValue " + getCell(hoverT, hoverD).toFixed(2)
                            : "Click a cell to edit"
                    }
                    RowLayout {
                        SpinBox {
                            id: editSpin
                            from: -100; to: 100; stepSize: 1
                            editable: true
                            // Qt's own SpinBox docs recommend this exact
                            // validator for a negative `from` - the default
                            // one is unreliable about accepting a leading
                            // "-" while typing a negative value.
                            validator: IntValidator { bottom: Math.min(editSpin.from, editSpin.to); top: Math.max(editSpin.from, editSpin.to) }
                            value: hoverT >= 0 ? Math.round(getCell(hoverT, hoverD)*100) : 0
                            onValueModified: {
                                if (hoverT >= 0) {
                                    setCellLocal(hoverT, hoverD, value/100.0)
                                    sendSetCell(hoverT, hoverD, value/100.0)
                                }
                                // Typing (or +/-, or the indicators) writes
                                // `value` imperatively, which replaces the
                                // declarative binding above with a plain
                                // static value - Qt.binding() re-establishes
                                // it, the documented fix for an editable
                                // control whose value should keep tracking
                                // external state after the user edits it.
                                // Without this, clicking a different map
                                // cell afterwards would keep showing this
                                // cell's value instead of the new one's.
                                value = Qt.binding(function() {
                                    return hoverT >= 0 ? Math.round(getCell(hoverT, hoverD)*100) : 0
                                })
                            }
                        }
                        Label { text: "%"; color: "#aaa" }
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Row/Col tools"; font.bold: true; color: "#ddd" }
                    RowLayout {
                        Label { text: "Row"; color: "#aaa" }
                        SpinBox {
                            id: rowSpin
                            from: 0; to: mapThrN-1; editable: true
                            value: curRow
                            // Writing `value` imperatively drops the binding
                            // above; Qt.binding() re-establishes it so the
                            // box keeps following clicks on the map.
                            onValueModified: {
                                curRow = value
                                value = Qt.binding(function() { return curRow })
                            }
                        }
                        Label { text: rowPct(curRow) + " % throttle"; color: "#aaa" }
                    }
                    Flow {
                        Layout.fillWidth: true
                        spacing: 4
                        Button { text: "+5%"; onClicked: bumpCells(0.05) }
                        Button { text: "-5%"; onClicked: bumpCells(-0.05) }
                        Button { text: "Smooth"; onClicked: smoothRow(curRow) }
                        Label {
                            text: selection.active ? "+/-5% applies to the selection" : "+/-5% applies to the whole row"
                            color: "#777"; font.pixelSize: 15
                        }
                        Button { text: "Copy row"; onClicked: clipboardRow = mapRowSlice(curRow) }
                        Button { text: "Paste row"; enabled: clipboardRow !== null; onClicked: pasteRow(curRow) }
                    }
                    RowLayout {
                        Label { text: "Col (duty)"; color: "#aaa" }
                        SpinBox { id: colSpin; from: 0; to: mapRowCols(curRow)-1; editable: true; value: 5 }
                        Label { text: dutyPct(curRow, colSpin.value) + " duty (row " + curRow + ")"; color: "#aaa" }
                    }
                    Flow {
                        Layout.fillWidth: true
                        spacing: 4
                        Button { text: "Copy col"; onClicked: clipboardCol = mapColSlice(colSpin.value) }
                        Button { text: "Paste col"; enabled: clipboardCol !== null; onClicked: pasteCol(colSpin.value) }
                        Button { text: "Interp. selection"; enabled: selection.active; onClicked: interpolateSelection() }
                    }

                    Label {
                        text: "Click a cell to aim these tools at it; drag to multi-select."
                        wrapMode: Text.WordWrap; color: "#777"; font.pixelSize: 16
                    }
                    }
                }

            // Every row/col tool reads curRow and colSpin, so a click has
            // to move them too - otherwise Copy/Paste silently operate on
            // whatever the spinboxes happened to be left at.
            function pickCell(c) {
                hoverT = c.t; hoverD = c.d
                curRow = c.t
                colSpin.value = c.d
            }
            function isSelected(t, d) {
                if (!selection.active) return false
                var tmin = Math.min(selection.t0, selection.t1), tmax = Math.max(selection.t0, selection.t1)
                var dmin = Math.min(selection.d0, selection.d1), dmax = Math.max(selection.d0, selection.d1)
                return t >= tmin && t <= tmax && d >= dmin && d <= dmax
            }
            function mapRowSlice(t) { var r = []; for (var d = 0; d < mapRowCols(t); d++) r.push(getCell(t,d)); return r }
            // Only meaningful within one half; the two do not share columns.
            function mapColSlice(d) {
                var r = [], t0 = curRow <= mapThrZero ? 0 : mapThrZero + 1
                var t1 = curRow <= mapThrZero ? mapThrZero + 1 : mapThrN
                for (var t = t0; t < t1; t++) r.push(getCell(t, Math.min(d, mapRowCols(t)-1)))
                return r
            }
            // These used to call setCellLocal per cell, each doing its own
            // full 441-element array copy + mapData reassignment (so a
            // 441-cell selection did up to ~194,000 element copies, and
            // every button click here forced multiple full canvas
            // redraws instead of one). Batch the mutation into a single
            // array copy and assign mapData exactly once instead.
            // Shifts every selected cell, or the whole current row when
            // nothing is selected. One array copy and one row upload per
            // touched row, not one per cell.
            function bumpCells(delta) {
                cfgPreset = 0
                var arr = mapData.slice()
                var rows = {}
                var tmin = curRow, tmax = curRow, dmin = 0, dmax = 20
                if (selection.active) {
                    tmin = Math.min(selection.t0, selection.t1)
                    tmax = Math.max(selection.t0, selection.t1)
                    dmin = Math.min(selection.d0, selection.d1)
                    dmax = Math.max(selection.d0, selection.d1)
                }
                for (var t = tmin; t <= tmax; t++) {
                    var hi = Math.min(dmax, mapRowCols(t) - 1)
                    for (var d = dmin; d <= hi; d++)
                        arr[cellIdx(t, d)] = Math.max(-1, Math.min(1, getCell(t, d) + delta))
                    rows[t] = true
                }
                mapData = arr
                for (var key in rows) sendSetMapRow(parseInt(key))
            }
            function smoothRow(t) {
                cfgPreset = 0
                var row = mapRowSlice(t)
                var out = row.slice()
                for (var d = 1; d < mapRowCols(t)-1; d++) out[d] = (row[d-1] + row[d]*2 + row[d+1]) / 4
                var arr = mapData.slice()
                for (var d2 = 0; d2 < mapRowCols(t); d2++) arr[cellIdx(t, d2)] = Math.max(-1, Math.min(1, out[d2]))
                mapData = arr
                sendSetMapRow(t)
            }
            function pasteRow(t) {
                cfgPreset = 0
                if (!clipboardRow) return
                var arr = mapData.slice()
                for (var d = 0; d < Math.min(mapRowCols(t), clipboardRow.length); d++)
                    arr[cellIdx(t, d)] = Math.max(-1, Math.min(1, clipboardRow[d]))
                mapData = arr
                sendSetMapRow(t)
            }
            function pasteCol(d) {
                cfgPreset = 0
                if (!clipboardCol) return
                var arr = mapData.slice()
                var t0 = curRow <= mapThrZero ? 0 : mapThrZero + 1
                var t1 = curRow <= mapThrZero ? mapThrZero + 1 : mapThrN
                for (var t = t0; t < t1 && t - t0 < clipboardCol.length; t++)
                    if (d < mapRowCols(t)) arr[cellIdx(t, d)] = Math.max(-1, Math.min(1, clipboardCol[t - t0]))
                mapData = arr
                for (var t2 = t0; t2 < t1; t2++) sendSetMapRow(t2)
            }
            function interpolateSelection() {
                cfgPreset = 0
                if (!selection.active) return
                var tmin = Math.min(selection.t0, selection.t1), tmax = Math.max(selection.t0, selection.t1)
                var dmin = Math.min(selection.d0, selection.d1), dmax = Math.max(selection.d0, selection.d1)
                var v0 = getCell(tmin, dmin), v1 = getCell(tmax, dmax)
                var arr = mapData.slice()
                var rows = {}
                for (var t = tmin; t <= tmax; t++) {
                    var ft = tmax > tmin ? (t - tmin) / (tmax - tmin) : 0
                    for (var d = dmin; d <= dmax && d < mapRowCols(t); d++) {
                        var fd = dmax > dmin ? (d - dmin) / (dmax - dmin) : 0
                        var f = (ft + fd) / (tmax > tmin || dmax > dmin ? (tmax>tmin && dmax>dmin ? 2 : 1) : 1)
                        arr[cellIdx(t, d)] = Math.max(-1, Math.min(1, v0 + (v1 - v0) * f))
                    }
                    rows[t] = true
                }
                mapData = arr
                for (var key in rows) sendSetMapRow(parseInt(key))
            }
        }
    }

    // =================================================================
    // Tab: Curves (2D cross-sections of the map, current-rel vs duty)
    // =================================================================
    Component {
        id: curvesTabComponent
        Item {
            id: curvesTab
            width: stackLayout.width
            height: stackLayout.height
            property var shownRows: ({10: true, 15: true, 20: true, 25: true, 30: true})
            property int pickedRow: 20

            // Explicit positioning, same reasoning as mapTabComponent -
            // see the comment there.
            property real curveH: Math.max(280, Math.round(curvesTab.height * 0.55))
            property real controlsY: curveH + 8
            property real controlsH: Math.max(140, curvesTab.height - controlsY - 4)

            Rectangle {
                id: curveBox
                x: 0; y: 0
                width: curvesTab.width
                height: curvesTab.curveH
                color: "#0e1013"; border.color: "#333"; radius: 4
                    Canvas {
                        id: curveCanvas
                        anchors.fill: parent
                        anchors.margins: 24
                        function rowColor(rowIdx) {
                            var f = rowIdx / (mapThrN - 1)
                            return Qt.rgba(0.3 + 0.6*f, 0.8 - 0.5*f, 0.9 - 0.7*f, 1)
                        }
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            try {
                                ctx.strokeStyle = "#444"; ctx.lineWidth = 1
                                var zeroY = height/2
                                ctx.beginPath(); ctx.moveTo(0, zeroY); ctx.lineTo(width, zeroY); ctx.stroke()
                                ctx.strokeStyle = "#333"
                                ctx.strokeRect(0, 0, width, height)

                                function plotRow(t, color, widthPx) {
                                    ctx.strokeStyle = color; ctx.lineWidth = widthPx
                                    ctx.beginPath()
                                    var cb = firstCol(), cn = 21 - cb
                                    for (var g = cb; g < 21; g++) {
                                        var d = dispCol(t, g)
                                        var x = (g - cb + 0.5) * (width / cn)
                                        var v = getCell(t, d)
                                        var y = height/2 - v * (height/2)
                                        if (g === cb) ctx.moveTo(x, y); else ctx.lineTo(x, y)
                                    }
                                    ctx.stroke()
                                }

                                for (var t = firstRow(); t < mapThrN; t++) {
                                    if (shownRows[t]) plotRow(t, curveCanvas.rowColor(t), 2)
                                }
                                plotRow(pickedRow, "#ffffff", 2)
                            } catch (e) {
                                ctx.fillStyle = "#ff5555"
                                ctx.font = "15px sans-serif"
                                ctx.textAlign = "left"
                                ctx.fillText("Draw error: " + e, 8, 20)
                            }
                        }
                        Connections { target: mainItem; function onMapDataChanged() { curveCanvas.requestPaint() } }
                        Connections { target: curvesTab; function onShownRowsChanged() { curveCanvas.requestPaint() } }
                        Connections { target: curvesTab; function onPickedRowChanged() { curveCanvas.requestPaint() } }
                        onWidthChanged: requestPaint()
                        onHeightChanged: requestPaint()
                        Component.onCompleted: requestPaint()
                    }

                    // Cheap overlay for just the live point - see the
                    // same split on the Map tab's heatmap for why.
                    Canvas {
                        id: curveDot
                        anchors.fill: curveCanvas
                        visible: showLiveCurve.checked
                        onPaint: {
                            var ctx = getContext("2d")
                            ctx.clearRect(0, 0, width, height)
                            var cb2 = firstCol()
                            var lx2 = (dutyToCol(liveDuty) - cb2 + 0.5) * (width / (21 - cb2))
                            var ly = height/2 - liveCurRel * (height/2)
                            ctx.beginPath(); ctx.arc(lx2, ly, 5, 0, 2*Math.PI)
                            ctx.fillStyle = "#00e5ff"; ctx.fill()
                        }
                        Connections { target: mainItem; function onLiveDutyChanged() { curveDot.requestPaint() } }
                        Connections { target: mainItem; function onLiveCurRelChanged() { curveDot.requestPaint() } }
                        onWidthChanged: requestPaint()
                        onHeightChanged: requestPaint()
                        Component.onCompleted: requestPaint()
                    }
                    Label { text: "-1.0"; color: "#777"; anchors.left: parent.left; anchors.bottom: parent.bottom; anchors.margins: 4 }
                    Label { text: "+1.0"; color: "#777"; anchors.left: parent.left; anchors.top: parent.top; anchors.margins: 4 }
                    Label { text: cfgBrakeMap === 1 ? "Duty -100% → +100%" : "Duty 0% → 100%"; color: "#777"; anchors.right: parent.right; anchors.bottom: parent.bottom; anchors.margins: 4 }
                }

                Flickable {
                    id: curvesControlsFlick
                    x: 0; y: curvesTab.controlsY
                    width: curvesTab.width
                    height: curvesTab.controlsH
                    clip: true
                    contentWidth: width
                    contentHeight: curvesControlsCol.implicitHeight + 16
                    boundsBehavior: Flickable.StopAtBounds
                    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AlwaysOn; width: 14 }
                    ColumnLayout {
                    id: curvesControlsCol
                    width: curvesControlsFlick.width - 20
                    Label { text: "Throttle rows shown"; font.bold: true; color: "#ddd" }
                    Repeater {
                        model: cfgBrakeMap === 1 ? [0, 5, 10, 15, 20, 25, 30] : [10, 15, 20, 25, 30]
                        CheckBox {
                            text: rowPct(modelData) + " %"
                            checked: !!shownRows[modelData]
                            onToggled: {
                                var m = Object.assign({}, shownRows)
                                m[modelData] = checked
                                shownRows = m
                            }
                        }
                    }
                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }
                    Label { text: "Pick any row"; font.bold: true; color: "#ddd" }
                    Slider { Layout.fillWidth: true; from: firstRow(); to: mapThrN-1; stepSize: 1; value: pickedRow; onMoved: pickedRow = value }
                    Label { text: rowPct(pickedRow) + " % throttle"; color: "#aaa" }
                    CheckBox { id: showLiveCurve; text: "Show live point"; checked: true }
                    }
                }
        }
    }

    // =================================================================
    // Tab: pseudo-3D isometric view (no Qt3D dependency, see docs)
    // =================================================================
    Component {
        id: iso3DTabComponent
        Item {
            id: iso3DTab
            width: stackLayout.width
            height: stackLayout.height
            // Adjustable "camera": rotDeg spins the grid around its
            // vertical axis, tiltFactor flattens/steepens the depth axis
            // (low = more top-down, high = more side-on). This is a 2D
            // affine transform, not a real 3D camera, but it's enough to
            // make the isometric view feel rotatable/tiltable without
            // pulling in a 3D engine - see docs/architecture.md for why
            // no Qt3D/QtQuick3D dependency was taken on.
            property real rotDeg: 45
            property real tiltFactor: 0.8

            property real controlsH: 64
            property real canvasH: Math.max(240, iso3DTab.height - controlsH - 8)

            Rectangle {
                x: 0; y: 0
                width: iso3DTab.width
                height: iso3DTab.canvasH
                color: "#0e1013"; border.color: "#333"; radius: 4

                Canvas {
                    id: isoCanvas
                    anchors.fill: parent
                    anchors.margins: 16
                    // Scaled to the canvas' real size, not fixed pixel
                    // constants - a 21x21 grid drawn at a few px/tile was
                    // an all-but-invisible speck in any normal-sized
                    // canvas, which is why this tab looked "empty" before
                    // the sizing chain was fixed.
                    property int rowBase: firstRow()
                    property int colBase: firstCol()
                    property real tileW: Math.max(4, 0.5 * width / (21 - colBase))
                    // Depth axis is scaled separately now that it has up
                    // to 31 rows against the duty axis' 11.
                    property real tileH: Math.max(3, 0.5 * height / (mapThrN - 1))
                    property real zScale: Math.max(20, height * 0.25)

                    // d is a shared column coordinate 0..20 (duty -100..+100)
                    function project(t, d, v) {
                        var rad = iso3DTab.rotDeg * Math.PI / 180
                        var ct = (rowBase + mapThrN - 1) / 2
                        var cd = (colBase + 20) / 2
                        var rt = t - ct, rd = d - cd
                        var cosr = Math.cos(rad), sinr = Math.sin(rad)
                        var pt = rt * cosr - rd * sinr
                        var pd = rt * sinr + rd * cosr
                        var ox = width/2
                        var oy = height * 0.55
                        var x = ox + pd * tileW
                        var y = oy - pt * tileH * iso3DTab.tiltFactor - v * zScale
                        return { x: x, y: y }
                    }

                    onPaint: {
                        var ctx = getContext("2d")
                        ctx.clearRect(0, 0, width, height)
                        try {
                            // painter's algorithm: back-to-front by (t+d),
                            // a decent approximation regardless of rotDeg
                            // Quads only within a half: the two do not share
                            // a column layout, so nothing spans the seam.
                            for (var s = 0; s <= (mapThrN-1) + 20; s++) {
                                for (var t = rowBase; t < mapThrN - 1; t++) {
                                    if (t + 1 === mapThrZero) continue
                                    var g0 = s - t
                                    if (g0 < colBase || g0 >= 20) continue
                                    var da = dispCol(t, g0), db = dispCol(t, g0+1)
                                    var v00 = getCell(t, da), v10 = getCell(t+1, da)
                                    var v01 = getCell(t, db), v11 = getCell(t+1, db)
                                    var p00 = project(t, g0, v00)
                                    var p10 = project(t+1, g0, v10)
                                    var p01 = project(t, g0+1, v01)
                                    var p11 = project(t+1, g0+1, v11)
                                    var avg = (v00+v10+v01+v11)/4
                                    var col = valueColor(avg)
                                    ctx.fillStyle = Qt.rgba(col.r, col.g, col.b, 1)
                                    ctx.beginPath()
                                    ctx.moveTo(p00.x, p00.y)
                                    ctx.lineTo(p10.x, p10.y)
                                    ctx.lineTo(p11.x, p11.y)
                                    ctx.lineTo(p01.x, p01.y)
                                    ctx.closePath()
                                    ctx.fill()
                                    ctx.strokeStyle = "rgba(0,0,0,0.25)"
                                    ctx.stroke()
                                }
                            }
                        } catch (e) {
                            ctx.fillStyle = "#ff5555"
                            ctx.font = "15px sans-serif"
                            ctx.textAlign = "left"
                            ctx.fillText("Draw error: " + e, 8, 20)
                        }
                    }
                    Connections { target: mainItem; function onMapDataChanged() { isoCanvas.requestPaint() } }
                    Connections { target: mainItem; function onCfgBrakeMapChanged() { isoCanvas.requestPaint() } }
                    onRowBaseChanged: requestPaint()
                    Connections { target: iso3DTab; function onRotDegChanged() { isoCanvas.requestPaint() } }
                    Connections { target: iso3DTab; function onTiltFactorChanged() { isoCanvas.requestPaint() } }
                    onWidthChanged: requestPaint()
                    onHeightChanged: requestPaint()
                    Component.onCompleted: requestPaint()
                }

                // Cheap overlay for just the live point - see the same
                // split on the Map tab's heatmap for why.
                Canvas {
                    id: isoDot
                    anchors.fill: isoCanvas
                    onPaint: {
                        var ctx = getContext("2d")
                        ctx.clearRect(0, 0, width, height)
                        var ti = rowPosOf(liveSigned())
                        var di = dutyToCol(liveDuty)
                        var lp = isoCanvas.project(ti, di, liveCurRel)
                        ctx.beginPath(); ctx.arc(lp.x, lp.y, 5, 0, 2*Math.PI)
                        ctx.fillStyle = "#00e5ff"; ctx.fill()
                        ctx.strokeStyle = "#003"; ctx.stroke()
                    }
                    Connections { target: mainItem; function onLiveDutyChanged() { isoDot.requestPaint() } }
                    Connections { target: mainItem; function onLiveThrottleChanged() { isoDot.requestPaint() } }
                    Connections { target: mainItem; function onLiveBrakeChanged() { isoDot.requestPaint() } }
                    Connections { target: mainItem; function onLiveCurRelChanged() { isoDot.requestPaint() } }
                    Connections { target: iso3DTab; function onRotDegChanged() { isoDot.requestPaint() } }
                    Connections { target: iso3DTab; function onTiltFactorChanged() { isoDot.requestPaint() } }
                    onWidthChanged: requestPaint()
                    onHeightChanged: requestPaint()
                    Component.onCompleted: requestPaint()
                }

                Label {
                    text: "Pseudo-3D (isometric Canvas). X = Duty -100..+100, depth = Throttle, height/color = Current Rel."
                    color: "#777"; anchors.left: parent.left; anchors.top: parent.top; anchors.margins: 6
                    wrapMode: Text.WordWrap
                }
            }

            ColumnLayout {
                x: 0; y: iso3DTab.canvasH + 8
                width: iso3DTab.width
                height: iso3DTab.controlsH
                spacing: 4
                // Stacked, not side by side - two Layout.preferredWidth:
                // 200 sliders in one RowLayout need ~500px+ combined and
                // never shrink below that, which is exactly the class of
                // bug found on the Map/Configurator tabs. A full-width
                // slider on its own row has no such minimum.
                RowLayout { Layout.fillWidth: true
                    Label { text: "Rotation"; color: "#ccc" }
                    Slider {
                        Layout.fillWidth: true
                        from: 0; to: 360
                        value: iso3DTab.rotDeg
                        onMoved: iso3DTab.rotDeg = value
                    }
                    Label { text: Math.round(iso3DTab.rotDeg) + "°"; color: "#fff" }
                }
                RowLayout { Layout.fillWidth: true
                    Label { text: "Tilt"; color: "#ccc" }
                    Slider {
                        Layout.fillWidth: true
                        from: 0.15; to: 1.3
                        value: iso3DTab.tiltFactor
                        onMoved: iso3DTab.tiltFactor = value
                    }
                    Label { text: iso3DTab.tiltFactor.toFixed(2); color: "#fff" }
                }
            }
        }
    }

    // =================================================================
    // Tab: Configurator (presets + parametric map generation + throttle
    // source setup + save/load/reset + text export/import)
    // =================================================================
    // =================================================================
    // Tab: Lock - a position hold that behaves like a torsion spring
    // =================================================================
    Component {
        id: lockTabComponent
        Item {
            id: lockTab
            width: stackLayout.width
            height: stackLayout.height

            Flickable {
                anchors.fill: parent
                clip: true
                contentWidth: width
                contentHeight: lockCol.implicitHeight + 16
                boundsBehavior: Flickable.StopAtBounds
                ScrollBar.vertical: ScrollBar { policy: ScrollBar.AlwaysOn; width: 14 }
                ColumnLayout {
                    id: lockCol
                    width: parent.width - 20
                    spacing: 10

                    Label { text: "Position lock"; font.bold: true; color: "#ddd" }
                    Label {
                        text: "Holds the machine in place without freezing it: it gives way under load, and pushes back harder the further it is moved. Position is read from the tachometer, which counts hall edges, so it is exact at a standstill and cannot drift."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    GridLayout {
                        columns: 2
                        Label { text: "State"; color: "#aaa" }
                        Label {
                            text: lockState === 1 ? "ENGAGED" : "released"
                            color: lockState === 1 ? "#00e5ff" : "#888"; font.bold: true
                        }
                        Label { text: "Deflection"; color: "#aaa" }
                        Label { text: lockErr.toFixed(3) + " turns"; color: "#fff" }
                        Label { text: "Hold current"; color: "#aaa" }
                        Label { text: (liveCurRel * 100).toFixed(1) + " % asked"; color: "#fff" }
                        Label { text: "Motor current"; color: "#aaa" }
                        Label {
                            text: liveCurA.toFixed(1) + " A measured"
                            color: (lockState === 1 && Math.abs(liveCurRel) > 0.01 && Math.abs(liveCurA) < 0.5) ? "#ff9955" : "#fff"
                        }
                        Label { text: "ERPM"; color: "#aaa" }
                        Label { text: liveRpmFast.toFixed(0); color: "#fff" }
                        Label { text: "Last release"; color: "#aaa" }
                        Label {
                            text: ["-", "timed out", "throttle input", "brake input",
                                   "package disabled", "you asked"][lockReason] || "-"
                            color: "#fff"
                        }
                    }
                    Label {
                        visible: lockState === 1 && Math.abs(liveCurRel) > 0.01 && Math.abs(liveCurA) < 0.5
                        text: "Current is being asked for and the motor is not taking it. That is a motor-side limit, not this loop: check the minimum current, the sensor mode at standstill, and that no other app is commanding the motor."
                        color: "#ff9955"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Flow {
                        Layout.fillWidth: true
                        spacing: 6
                        Button {
                            text: "ENGAGE"
                            enabled: lockState === 0 && pkgEnabled === 1
                            onClicked: { sendLockCfg(); sendLock(true) }
                        }
                        Button {
                            text: "RELEASE"
                            Material.background: "#b23b3b"
                            enabled: lockState === 1
                            onClicked: sendLock(false)
                        }
                    }
                    Label {
                        text: "Engaging is refused unless the machine is stopped with nothing asked of it. Any throttle or brake input releases it immediately."
                        color: "#9bd"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    Label {
                        text: "Holding current at a standstill puts all the heat into one or two phases with no cooling from rotation. Keep the ceiling low and do not treat this as a parking brake."
                        color: "#ff9955"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }
                    Label { text: "Settings"; font.bold: true; color: "#ddd" }

                    ColumnLayout {
                        Layout.fillWidth: true; spacing: 2
                        RowLayout { Layout.fillWidth: true
                            Label { text: "Hold time (s, 0 = no limit)"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                            TextField {
                                Layout.preferredWidth: 60
                                horizontalAlignment: TextInput.AlignRight
                                text: lockTimeout.toFixed(0)
                                onEditingFinished: {
                                    var v = parseClamped(text, 0, 255)
                                    if (v !== null) { lockTimeout = Math.round(v); sendLockCfg() }
                                    text = Qt.binding(function() { return lockTimeout.toFixed(0) })
                                }
                            }
                        }
                        Slider {
                            Layout.fillWidth: true; from: 0; to: 255; stepSize: 5
                            value: lockTimeout
                            onMoved: lockTimeout = Math.round(value)
                            onPressedChanged: if (!pressed) sendLockCfg()
                        }
                    }
                    Label {
                        text: "How long it may hold before letting go on its own. 0 removes the limit entirely - the heat in the phases is then yours to watch."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    ColumnLayout {
                        Layout.fillWidth: true; spacing: 2
                        RowLayout { Layout.fillWidth: true
                            Label { text: "Tolerated travel (turns)"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                            TextField {
                                Layout.preferredWidth: 60
                                horizontalAlignment: TextInput.AlignRight
                                text: lockTravel.toFixed(2)
                                onEditingFinished: {
                                    var v = parseClamped(text, 0.0, 10.0)
                                    if (v !== null) { lockTravel = v; sendLockCfg() }
                                    text = Qt.binding(function() { return lockTravel.toFixed(2) })
                                }
                            }
                        }
                        Slider {
                            Layout.fillWidth: true; from: 0.0; to: 10.0; stepSize: 0.05
                            value: lockTravel
                            onMoved: lockTravel = value
                            onPressedChanged: if (!pressed) sendLockCfg()
                        }
                    }
                    Label {
                        text: "Wheel turns it may be pushed through before the hold reaches its current ceiling. Smaller is stiffer; 0 means full current at the first millimetre of movement."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    ColumnLayout {
                        Layout.fillWidth: true; spacing: 2
                        RowLayout { Layout.fillWidth: true
                            Label { text: "Max hold current"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                            TextField {
                                Layout.preferredWidth: 60
                                horizontalAlignment: TextInput.AlignRight
                                text: lockMax.toFixed(2)
                                onEditingFinished: {
                                    var v = parseClamped(text, 0.02, 0.50)
                                    if (v !== null) { lockMax = v; sendLockCfg() }
                                    text = Qt.binding(function() { return lockMax.toFixed(2) })
                                }
                            }
                        }
                        Slider {
                            Layout.fillWidth: true; from: 0.02; to: 0.50
                            value: lockMax
                            onMoved: lockMax = value
                            onPressedChanged: if (!pressed) sendLockCfg()
                        }
                    }
                    Label {
                        text: "Fraction of the configured motor current. This is the thermal ceiling - start low."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    ColumnLayout {
                        Layout.fillWidth: true; spacing: 2
                        RowLayout { Layout.fillWidth: true
                            Label { text: "Damping"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                            TextField {
                                Layout.preferredWidth: 60
                                horizontalAlignment: TextInput.AlignRight
                                text: lockDamp.toFixed(2)
                                onEditingFinished: {
                                    var v = parseClamped(text, 0.0, 1.0)
                                    if (v !== null) { lockDamp = v; sendLockCfg() }
                                    text = Qt.binding(function() { return lockDamp.toFixed(2) })
                                }
                            }
                        }
                        Slider {
                            Layout.fillWidth: true; from: 0.0; to: 1.0
                            value: lockDamp
                            onMoved: lockDamp = value
                            onPressedChanged: if (!pressed) sendLockCfg()
                        }
                    }
                    Label {
                        text: "Resists speed rather than position. Without it the spring rings - inertia overshoots every time. Tune it first, high, then lower it until it just stops bouncing."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Label {
                        text: "Position is read from the tachometer, so it is exact at a standstill and never drifts. Turns are scaled with the wheel diameter and gear ratio from your motor configuration - if those are wrong, the numbers are rescaled but the hold itself is unaffected."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Label {
                        text: "Settings are not saved to EEPROM - the store is full. They are sent from here each time you engage, so keep VESC Tool connected while using the lock."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                }
            }
        }
    }

    Component {
        id: configuratorTabComponent
        Item {
            id: cfgTab
            width: stackLayout.width
            height: stackLayout.height

            // Preset selection and the 8 map-shaping sliders now live on
            // the Map tab itself (see mapTabComponent), so you can watch
            // the heatmap react as you drag them - applyPresetValues/
            // regenerateLocalMap/presets are shared globals on mainItem,
            // not duplicated here.

            Flickable {
                id: cfgFlick
                anchors.fill: parent
                clip: true
                contentWidth: width
                contentHeight: cfgCol.implicitHeight + 16
                boundsBehavior: Flickable.StopAtBounds
                ScrollBar.vertical: ScrollBar { policy: ScrollBar.AlwaysOn; width: 14 }
                ColumnLayout {
                    id: cfgCol
                    width: cfgFlick.width - 20
                    spacing: 10

                    Label { text: "Package"; font.bold: true; color: "#ddd" }
                    CheckBox {
                        text: "Package enabled"
                        checked: pkgEnabled === 1
                        onToggled: { pkgEnabled = checked ? 1 : 0; sendEnabled(checked) }
                    }
                    Label {
                        text: pkgEnabled === 1
                            ? "Turn this off to hand the motor back without uninstalling: the package stops issuing any command at all, and the controller releases the motor on its own timeout. The setting is saved, so it survives a reboot."
                            : "OFF - this package is commanding nothing. The controller has released the motor, and another app can drive it. Nothing here affects the motor until you switch it back on."
                        color: pkgEnabled === 1 ? "#777" : "#ff9955"
                        wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label {
                        text: "Preset and map-shaping sliders (Torque response, Speed coupling, " +
                              "Transition width/shape, High throttle hold, Engine braking, Overrun " +
                              "regen, Regen curve) are on the Map tab now, right above the heatmap, " +
                              "so you can see the map update live as you adjust them."
                        color: "#9bd"; wrapMode: Text.WordWrap; Layout.fillWidth: true
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Throttle source"; font.bold: true; color: "#ddd" }
                    RowLayout {
                        ComboBox {
                            id: srcCombo
                            model: ["ADC", "PPM", "UART", "Test (bench, via USB)"]
                            currentIndex: thrSource
                            onActivated: (idx) => { thrSource = idx; sendSetThrottle() }
                        }
                        CheckBox { text: "Invert"; checked: thrInvert === 1; onToggled: thrInvert = checked ? 1 : 0 }
                    }
                    ColumnLayout {
                        visible: thrSource === 0
                        Layout.fillWidth: true
                        spacing: 2
                        Label { text: "ADC input mode"; color: "#ccc" }
                        ComboBox {
                            Layout.fillWidth: true
                            model: ["Normal: ADC1, accelerator only",
                                    "Double ADC: ADC1 accelerator + ADC2 brake",
                                    "Bidirectional: ADC1 accelerator / brake"]
                            currentIndex: thrBrakeMode
                            onActivated: (idx) => { thrBrakeMode = idx; sendSetThrottle() }
                        }
                    }
                    Label {
                        visible: thrSource === 0 && thrBrakeMode === 1
                        text: "ADC1 is the accelerator and ADC2 is the brake. Both use VESC Tool's ADC calibration."
                        color: "#9bd"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    Label {
                        visible: thrSource === 0 && thrBrakeMode === 2
                        text: "ADC1 is split around a package-specific neutral point. VESC Tool owns ADC Start/End; place the control at rest, then calibrate its neutral voltage below."
                        color: "#9bd"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    RowLayout {
                        visible: thrSource === 0 && thrBrakeMode === 2
                        Layout.fillWidth: true
                        Label { text: "ADC1 live: " + liveAdcVoltage.toFixed(3) + " V"; color: "#fff"; Layout.fillWidth: true }
                        Button { text: "CALIBRER"; onClicked: calibrateBidirectional() }
                    }
                    Label {
                        visible: thrSource === 0 && thrBrakeMode !== 0
                        text: cfgBrakeMap === 1
                            ? "The brake side reads the negative half of the map: how hard it brakes depends on both lever travel and speed, exactly like the traction half."
                            : "Either mode overrides the map with a direct, proportional negative current-rel whenever the brake side is above its deadband."
                        color: "#9bd"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Braking"; font.bold: true; color: "#ddd" }
                    CheckBox {
                        text: "Tunable brake map (negative throttle rows)"
                        checked: cfgBrakeMap === 1
                        onToggled: { cfgBrakeMap = checked ? 1 : 0; sendSetConfig(false) }
                    }
                    Label {
                        text: cfgBrakeMap === 1
                            ? "The map grows downwards to -100% throttle: 10 extra rows you tune the same way as the traction ones, with their own generator on the Map tab. The traction sliders never touch them, and their generator never touches the traction rows."
                            : "Off: the brake lever commands a plain proportional brake, unchanged from the stable package. Turn it on to shape braking against speed too."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    // Only braking requests go through this. Propulsion -
                    // forwards or backwards - is always relative current.
                    Label { text: "Brake type"; color: "#ccc" }
                    ComboBox {
                        Layout.fillWidth: true
                        model: ["Regen only",
                                "Current, no reverse",
                                "Current, bidirectional (reverse)"]
                        currentIndex: cfgBrakeType
                        onActivated: (idx) => { cfgBrakeType = idx; sendSetConfig(false) }
                    }
                    Label {
                        text: ["Regen only: braking leaves as a relative brake command, which opposes rotation by construction. Reversing still uses negative current - asking for reverse is propulsion, not braking.",
                               "Current, no reverse: braking is torque against the motion, down to a complete stop. This is the one type that refuses to start the vehicle backwards, holding zero instead.",
                               "Current, bidirectional: braking is torque against the motion, and reverse is allowed - it decelerates, stops and drives on backwards."][cfgBrakeType]
                        color: "#9bd"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    Label {
                        text: "Braking means torque against the way the vehicle is actually moving, wherever the value comes from: engine braking with the throttle released, overrun regen, the brake channel, or stopping a reverse. Everything else is propulsion and always goes out as relative current."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }


                    // No ADC/PPM/UART hardware wired up yet? Pick "Test
                    // (bench, via USB)" above, then drag this - it drives
                    // the real control loop over the same USB/CAN link
                    // VESC Tool is already connected through, no wiring
                    // needed. See SET_TEST_THROTTLE in docs/protocol.md.
                    ColumnLayout {
                        visible: thrSource === 3
                        Layout.fillWidth: true
                        Label { text: "Bench throttle (test source)"; font.bold: true; color: "#ddd" }
                        RowLayout {
                            Layout.fillWidth: true
                            Slider {
                                id: benchThrottle
                                Layout.fillWidth: true
                                from: cfgBrakeMap === 1 ? -1 : 0; to: 1
                                value: mainItem.benchValue
                                onMoved: sendTestThrottle(value)
                                onPressedChanged: if (!pressed) sendTestThrottle(value)
                            }
                            Label { text: (benchThrottle.value*100).toFixed(0) + " %"; color: "#fff" }
                            Button {
                                text: "STOP"
                                Material.background: "#b23b3b"
                                onClicked: { benchThrottle.value = 0; sendTestThrottle(0) }
                            }
                        }
                        Label {
                            text: "STOP clears the bench throttle immediately. Link loss clears the command after 500 ms."
                            color: "#996"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 10
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Deadband"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: thrDeadband.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0, 0.15)
                                        if (v !== null) thrDeadband = v
                                        text = Qt.binding(function() { return thrDeadband.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0; to: 0.15; value: thrDeadband; onMoved: thrDeadband = value }
                        }
                        ColumnLayout {
                            Layout.fillWidth: true; spacing: 2
                            RowLayout { Layout.fillWidth: true
                                Label { text: "Filter (1.0 = off)"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                                TextField {
                                    Layout.preferredWidth: 60
                                    horizontalAlignment: TextInput.AlignRight
                                    text: thrFilter.toFixed(2)
                                    onEditingFinished: {
                                        var v = parseClamped(text, 0.001, 1.0)
                                        if (v !== null) thrFilter = v
                                        text = Qt.binding(function() { return thrFilter.toFixed(2) })
                                    }
                                }
                            }
                            Slider { Layout.fillWidth: true; from: 0.001; to: 1.0; value: thrFilter; onMoved: thrFilter = value }
                        }
                    }
                    Button { text: "Apply throttle settings"; onClicked: sendSetThrottle() }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Duty feedback filter"; font.bold: true; color: "#ddd" }
                    Label {
                        text: "The map reads duty back and turns it into a current request, so it is a closed loop. Near a balance point its slope reaches 0.10 of current per 1% of duty, which turns duty ripple straight into torque ripple. This smooths the duty that is read, never the current that is commanded - the throttle still reaches its map value on the very next tick."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    ColumnLayout {
                        Layout.fillWidth: true; spacing: 2
                        RowLayout { Layout.fillWidth: true
                            Label { text: "Duty filter"; color: "#ccc"; Layout.fillWidth: true; elide: Text.ElideRight }
                            TextField {
                                Layout.preferredWidth: 60
                                horizontalAlignment: TextInput.AlignRight
                                text: cfgDutyFilter.toFixed(2)
                                onEditingFinished: {
                                    var v = parseClamped(text, 0.01, 1.0)
                                    if (v !== null) { cfgDutyFilter = v; sendSetThrottle() }
                                    text = Qt.binding(function() { return cfgDutyFilter.toFixed(2) })
                                }
                            }
                        }
                        Slider {
                            Layout.fillWidth: true; from: 0.01; to: 1.0
                            value: cfgDutyFilter
                            onMoved: cfgDutyFilter = value
                            onPressedChanged: if (!pressed) sendSetThrottle()
                        }
                    }
                    Label {
                        text: "1.00 is unfiltered, as every build before this one. Lower values smooth the duty the map reads; 0.30 is about a 14 ms time constant at the 200 Hz loop rate. It changes how fast the map notices a speed change, not how fast it answers the throttle."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Persistence"; font.bold: true; color: "#ddd" }
                    // Flow, not RowLayout: 4 buttons with fairly long
                    // labels never shrink and never wrap in a RowLayout,
                    // which was overflowing narrow widths - Flow wraps
                    // to a new line instead of forcing the row wider.
                    Flow {
                        Layout.fillWidth: true
                        spacing: 6
                        Button { text: "Save to VESC"; onClicked: sendSave() }
                        Button { text: "Load from VESC"; onClicked: { sendLoad(); requestMap(); requestCfg() } }
                        Button { text: "Refresh from VESC"; onClicked: { requestMap(); requestCfg() } }
                        Button { text: "Reset to defaults"; onClicked: { sendReset(); requestMap(); requestCfg() } }
                    }
                    // lastCmdStatus gets set on every STATUS reply (see
                    // handleRx) but had nowhere to show up before. Save
                    // especially pauses the motor for a few seconds (see
                    // docs/map_format.md), so confirming it actually
                    // landed matters here.
                    Label {
                        text: lastCmdStatus
                        color: "#9bd"; Layout.fillWidth: true; elide: Text.ElideRight
                    }

                    Rectangle { Layout.fillWidth: true; height: 1; color: "#333" }

                    Label { text: "Export / Import (text)"; font.bold: true; color: "#ddd" }
                    Label {
                        text: "There is no supported way for a package's QML to write an arbitrary local file in VESC Tool, so export/import goes through plain text you copy/paste yourself."
                        color: "#777"; wrapMode: Text.WordWrap; Layout.fillWidth: true; font.pixelSize: 16
                    }
                    Flow {
                        Layout.fillWidth: true
                        spacing: 6
                        Button { text: "Export to text"; onClicked: exportArea.text = JSON.stringify({ map: mapData, cfg: {
                            preset: cfgPreset, torqueResp: cfgTorqueResp, speedCoupling: cfgSpeedCoupling,
                            transWidth: cfgTransWidth, transShape: cfgTransShape, highHold: cfgHighHold,
                            engineBrake: cfgEngineBrake, overrunRegen: cfgOverrunRegen, regenCurve: cfgRegenCurve,
                            thrSource: thrSource, thrInvert: thrInvert,
                            thrDeadband: thrDeadband, thrFilter: thrFilter, thrBrakeMode: thrBrakeMode,
                            dutyFilter: cfgDutyFilter,
                            brakeMap: cfgBrakeMap, brakeType: cfgBrakeType,
                            brakeStr: cfgBrakeStr, brakeResp: cfgBrakeResp,
                            brakeDep: cfgBrakeDep, brakeCurve: cfgBrakeCurve,
                            revCoupling: cfgRevCoupling, revWidth: cfgRevWidth,
                            revOverrun: cfgRevOverrun, revStr: cfgRevStr,
                            revResp: cfgRevResp, revHold: cfgRevHold,
                            revShape: cfgRevShape, revCurve: cfgRevCurve } }) }
                        Button {
                            text: "Import from text"
                            onClicked: {
                                try {
                                    var obj = JSON.parse(exportArea.text)
                                    validateImport(obj)
                                    mapData = obj.map.map(quantizeCell)
                                    if (obj.cfg) {
                                        cfgPreset = obj.cfg.preset; cfgTorqueResp = obj.cfg.torqueResp
                                        cfgSpeedCoupling = obj.cfg.speedCoupling; cfgTransWidth = obj.cfg.transWidth
                                        cfgTransShape = obj.cfg.transShape; cfgHighHold = obj.cfg.highHold
                                        cfgEngineBrake = obj.cfg.engineBrake; cfgOverrunRegen = obj.cfg.overrunRegen
                                        cfgRegenCurve = obj.cfg.regenCurve; thrSource = obj.cfg.thrSource
                                        thrInvert = obj.cfg.thrInvert
                                        thrDeadband = obj.cfg.thrDeadband; thrFilter = obj.cfg.thrFilter
                                        cfgDutyFilter = obj.cfg.dutyFilter === undefined ? 0.30 : obj.cfg.dutyFilter
                                        thrBrakeMode = obj.cfg.thrBrakeMode === undefined ? 0 : obj.cfg.thrBrakeMode
                                        cfgBrakeMap = obj.cfg.brakeMap === undefined ? 0 : obj.cfg.brakeMap
                                        cfgBrakeType = obj.cfg.brakeType === undefined ? 0 : obj.cfg.brakeType
                                        cfgBrakeStr = obj.cfg.brakeStr === undefined ? 1.0 : obj.cfg.brakeStr
                                        cfgBrakeResp = obj.cfg.brakeResp === undefined ? 1.0 : obj.cfg.brakeResp
                                        cfgBrakeDep = obj.cfg.brakeDep === undefined ? 0.0 : obj.cfg.brakeDep
                                        cfgRevCoupling = obj.cfg.revCoupling === undefined ? 1.0 : obj.cfg.revCoupling
                                        cfgRevWidth = obj.cfg.revWidth === undefined ? 0.10 : obj.cfg.revWidth
                                        cfgRevOverrun = obj.cfg.revOverrun === undefined ? 0.12 : obj.cfg.revOverrun
                                        cfgRevStr = obj.cfg.revStr === undefined ? 1.0 : obj.cfg.revStr
                                        cfgRevResp = obj.cfg.revResp === undefined ? 1.0 : obj.cfg.revResp
                                        cfgRevHold = obj.cfg.revHold === undefined ? 0.0 : obj.cfg.revHold
                                        cfgRevShape = obj.cfg.revShape === undefined ? 1 : obj.cfg.revShape
                                        cfgRevCurve = obj.cfg.revCurve === undefined ? 1 : obj.cfg.revCurve
                                        cfgBrakeCurve = obj.cfg.brakeCurve === undefined ? 0 : obj.cfg.brakeCurve
                                    }
                                    regenDebounce.stop(); sendSetConfig(false); sendSetThrottle(); sendAllRows(); requestMap()
                                    lastCmdStatus = "Imported from text"
                                } catch (e) { lastCmdStatus = "Import failed: " + e }
                            }
                        }
                        Button { text: "Copy to clipboard"; onClicked: { exportArea.selectAll(); exportArea.copy() } }
                    }
                    Label {
                        text: lastCmdStatus
                        color: "#9bd"; Layout.fillWidth: true; elide: Text.ElideRight
                    }
                    TextArea {
                        id: exportArea
                        Layout.fillWidth: true
                        Layout.preferredHeight: 140
                        wrapMode: TextArea.Wrap
                        selectByMouse: true
                        color: "#ddd"
                        background: Rectangle { color: "#0e1013"; border.color: "#333" }
                    }
                }
            }
        }
    }
}
